+// rows[i] of src (pinned host memory, mapped) to the same row of dst
+static __global__ void k_moe_gpu_copy_rows(const float4 * __restrict__ src, const int32_t * __restrict__ rows, float4 * __restrict__ dst, int n4) {
+    const int64_t off = (int64_t) rows[blockIdx.x]*n4;
+    for (int i = threadIdx.x; i < n4; i += blockDim.x) {
+        dst[off + i] = src[off + i];
