+// GGML_FA_MQA_PROF=1: cycles per call in each phase of ggml_fa_mqa_decode, per thread, printed at exit
+#include <x86intrin.h>
+enum { FAP_SETUP, FAP_CONV, FAP_QK, FAP_SM, FAP_PV, FAP_BAR, FAP_MERGE, FAP_N };
+static int g_fap_on = -1;
+static uint64_t g_fap[256][FAP_N];
+static uint64_t g_fap_calls[256];
+static void ggml_fap_print(void) {
+    static const char * nm[FAP_N] = { "setup", "convert", "qk", "softmax", "pv", "barrier", "merge" };
+    int n = 0;
+    while (n < 256 && g_fap_calls[n]) ++n;
+    if (!n) return;
+    fprintf(stderr, "fa_mqa_prof: %d threads, %llu calls, us per call (mean / max over threads):", n, (unsigned long long) g_fap_calls[0]);
+    double tot = 0;
+    for (int k = 0; k < FAP_N; ++k) {
+        double sum = 0, mx = 0;
+        for (int i = 0; i < n; ++i) { const double v = (double) g_fap[i][k]/g_fap_calls[i]/2400.0; sum += v; mx = v > mx ? v : mx; }
+        fprintf(stderr, " %s %.1f/%.1f", nm[k], sum/n, mx);
+        tot += sum/n;
+    }
+    fprintf(stderr, " total %.1f\n", tot);
+}
+#define FAP(k) do { if (fap) { const uint64_t t_ = __rdtsc(); g_fap[ith][k] += t_ - fap_t; fap_t = t_; } } while (0)
+
+// DeepSeek-V4 decode attention: one shared fp16 K/V head, f32 Q, up to 8 query rows.
+// Returns false (before touching anything) when the node is not that shape.
+static bool ggml_fa_mqa_decode(const struct ggml_compute_params * params, struct ggml_tensor * dst) {
+    if (!ggml_fa_mqa_ok(dst)) return false;
+    if (g_fap_on < 0) {
+        const char * e = getenv("GGML_FA_MQA_PROF");
+        g_fap_on = e && atoi(e) ? 1 : 0;
+        if (g_fap_on) atexit(ggml_fap_print);
+    }
+    const bool fap = g_fap_on && params->ith < 256;
+    uint64_t fap_t = fap ? __rdtsc() : 0;
+    const struct ggml_tensor * q = dst->src[0], * k = dst->src[1], * v = dst->src[2];
+    const struct ggml_tensor * mask = dst->src[3], * sinks = dst->src[4];
+    // K/V of a lazy concat exist only as its sources: no other path can read them
+    const struct ggml_tensor * kl = ggml_fa_mqa_lazy(k), * vl = ggml_fa_mqa_lazy(v);
+    float scale, softcap;
+    memcpy(&scale,    (float *) dst->op_params + 0, sizeof(float));
+    memcpy(&softcap,  (float *) dst->op_params + 2, sizeof(float));
+    const int ith = params->ith, nth = params->nth;
+    if (fap) g_fap_calls[ith]++;
+    if (params->wsize < ggml_fa_mqa_work_floats(dst, nth)*sizeof(float)) {
+        GGML_ASSERT(!kl && !vl);
+        return false;
+    }
+    if (softcap != 0.0f) scale /= softcap;
+
+    const int64_t Dk = k->ne[0], Dv = v->ne[0], H = q->ne[2], NQ = q->ne[1], nkv = k->ne[1];
+    const int BR = GGML_FA_MQA_BR;
+    // without a mask, src[5] lists the K rows of each query (negative entries are padding)
+    const struct ggml_tensor * idx = !mask ? dst->src[5] : NULL;
+
+    // 64-byte aligned: the state of a head is Dv accumulators, max, sum, padding to SD floats
+    const int64_t SD = Dv + 16;
+    float * part    = (float *)(((uintptr_t) params->wdata + 63) & ~(uintptr_t) 63);
+    const size_t TF = ggml_fa_mqa_thread_floats(Dk, Dv, H, NQ, nkv, nth), hpt = ggml_fa_mqa_hpt(H, nth);
+    float * scratch = part + NQ*GGML_FA_MQA_CMAX*H*SD + (size_t)ith*TF;
+    float * Kt   = scratch;
+    float * Vt   = Kt + BR*Dk;
+    float * P    = Vt + BR*Dv;
+    float * corr = P + H*BR;
+    float * mvs  = corr + H*BR;
+    int32_t * rows = (int32_t *)(mvs + NQ*nkv);
+    uint8_t * seen = (uint8_t *)(rows + nkv);
+    // running states: in the thread's own memory (no other thread touches it), streamed to part at the end
+    float * acc = (float *)(((uintptr_t)(scratch + BR*(Dk + Dv) + 2*H*BR + (NQ + 1)*nkv + nkv/4) + 63) & ~(uintptr_t) 63);
+    // rows converted once, shared by the threads of a chunk (after all the threads' scratch)
+    float * kconv = (float *)(((uintptr_t)(part + NQ*GGML_FA_MQA_CMAX*H*SD + (size_t)nth*TF) + 63) & ~(uintptr_t) 63);
+
+    // the same chunking on every thread: by the number of visible rows of query 0
+    int64_t n0 = 0;
+    if (mask) {
+        const uint16_t * m0 = (const uint16_t *) mask->data;
+        for (int64_t i = 0; i < nkv; ++i) n0 += m0[i] != 0xfc00;
+    } else if (idx) {
+        const int32_t * i0 = (const int32_t *) idx->data;
+        for (int64_t i = 0; i < idx->ne[0]; ++i) n0 += i0[i] >= 0;
+    } else {
+        n0 = nkv;
+    }
+    // chunks of >= min_rows rows, at most GGML_FA_MQA_CHUNKS (4; more chunks: fewer conversions per row, more merging)
+    static int min_rows = -1;
+    if (min_rows < 0) {
+        const char * e = getenv("GGML_FA_MQA_MINROWS");
+        min_rows = e ? MAX(1, atoi(e)) : 64;
+    }
+    // With GGML_NUMA_BLOCKED (consecutive threads on a node) each node takes a contiguous range of
+    // heads over all the rows, split in chunks among its threads. The chunk states of a head (Dv
+    // floats each, 64 heads: 128 KB per chunk, more than the rows read) are then merged by the node
+    // that wrote them, not moved between sockets. GGML_FA_MQA_NODES=1 (off by default: every node then reads all the rows).
+    static int by_node = -1, cmax = -1;
+    if (by_node < 0) {
+        const char * e = getenv("GGML_FA_MQA_NODES");
+        by_node = e && atoi(e) != 0;
+        const char * m = getenv("GGML_FA_MQA_CHUNKS");
+        cmax = m ? MAX(1, MIN(GGML_FA_MQA_CMAX, atoi(m))) : 4;
+    }
+    const int hbn = params->shared->hb_n_nodes;
+    const int NN = by_node && hbn > 1 && nth % hbn == 0 && H % hbn == 0 ? hbn : 1;
+    const int TPN = nth / NN, node = ith / TPN, li = ith % TPN;
+    int C = 1;
+    while (2*C <= cmax && 2*C <= TPN && TPN % (2*C) == 0 && n0 >= min_rows*C) C *= 2;
+    const int Gn = TPN / C, G = NN*Gn;
+    // consecutive threads of a node share a chunk (once from memory, then from L3 for the other head groups)
+    const int c = li / Gn, g = node*Gn + li % Gn;
+    // DeepSeek-V4 passes the same tensor as K and V: convert each row once
+    const bool kv_same = k->data == v->data && k->nb[1] == v->nb[1] && Dk == Dv;
+    const int64_t h0 = H*g/G, h1 = H*(g + 1)/G;
+
+    // With a mask, the queries go through the rows together: the rows any of them sees, with -inf
+    // for a query that does not see a row. Each block of rows is then converted once for all of
+    // them, not once per query (the verify batch of speculative decoding sees nearly the same rows).
+    static int multi = -1;
+    if (multi < 0) {
+        const char * e = getenv("GGML_FA_MQA_MULTI");
+        multi = !e || atoi(e) != 0;
+    }
+    // The same with row lists (src[5]): the union of the rows of the queries, each query seeing its own.
+    const int64_t nqp = (mask || idx) && multi ? NQ : 1;
+    // The G threads of a chunk convert its rows together (each row once, not once per head group), then all of
+    // them score the chunk from the converted rows. GGML_FA_MQA_SHARED=0: each head group converts the rows itself.
+    static int shconv_on = -1;
+    if (shconv_on < 0) {
+        const char * e = getenv("GGML_FA_MQA_SHARED");
+        shconv_on = !e || atoi(e) != 0;
+    }
+    const bool shconv = shconv_on && kv_same && nqp == NQ && Gn > 1;
+
+    for (int64_t iq = 0; iq < NQ; iq += nqp) {
+        // rows of this pass, and the mask value of each of its queries on them (mvs + a*nkv)
+        int64_t n = 0;
+        if (mask) {
+            const uint16_t * mq[8];
+            for (int64_t a = 0; a < nqp; ++a) mq[a] = (const uint16_t *)((const char *) mask->data + (iq + a)*mask->nb[1]);
+            for (int64_t i = 0; i < nkv; ++i) {
+                int vis = 0;
+                for (int64_t a = 0; a < nqp; ++a) vis |= mq[a][i] != 0xfc00;
+                if (!vis) continue;
+                rows[n] = (int32_t) i;
+                for (int64_t a = 0; a < nqp; ++a) mvs[a*nkv + n] = mq[a][i] == 0xfc00 ? -INFINITY : GGML_FP16_TO_FP32(mq[a][i]);
+                ++n;
+            }
+        } else if (idx && nqp > 1) {
+            memset(seen, 0, nkv);
+            for (int64_t a = 0; a < nqp; ++a) {
+                const int32_t * ip = (const int32_t *)((const char *) idx->data + (iq + a)*idx->nb[1]);
+                for (int64_t i = 0; i < idx->ne[0]; ++i) {
+                    if (ip[i] >= 0 && ip[i] < nkv) seen[ip[i]] |= (uint8_t)(1u << a);
+                }
+            }
+            for (int64_t i = 0; i < nkv; ++i) {
+                if (!seen[i]) continue;
+                rows[n] = (int32_t) i;
+                for (int64_t a = 0; a < nqp; ++a) mvs[a*nkv + n] = seen[i] >> a & 1 ? 0.0f : -INFINITY;
+                ++n;
+            }
+        } else if (idx) {
+            const int32_t * ip = (const int32_t *)((const char *) idx->data + iq*idx->nb[1]);
+            for (int64_t i = 0; i < idx->ne[0]; ++i) {
+                if (ip[i] < 0) continue;
+                rows[n] = ip[i]; mvs[n] = 0.0f; ++n;
+            }
+        } else {
+            for (int64_t i = 0; i < nkv; ++i) { rows[n] = (int32_t) i; mvs[n] = 0.0f; ++n; }
+        }
+        const int64_t r0 = n*c/C, r1 = n*(c + 1)/C;
+        // the rows of the chunk, converted (padded to a multiple of 4 with copies of its last row)
+        float * kc = kconv + ((size_t) node*(nkv + 4*GGML_FA_MQA_CMAX) + r0 + 4*c)*Dk;
+        if (shconv) {
+            const int64_t nc = r1 - r0, ng = (nc + 3)/4, gi = li % Gn;
+            for (int64_t j = 4*(ng*gi/Gn); j < 4*(ng*(gi + 1)/Gn); ++j) {
+                ggml_fa_f16_to_f32_row(ggml_fa_mqa_row(k, kl, rows[r0 + MIN(j, nc - 1)]), kc + j*Dk, Dk);
+            }
+            FAP(FAP_CONV);
+            ggml_barrier(params->shared);
+            FAP(FAP_BAR);
+        }
+
+        // state of head h of query iq + a: Dv accumulators, running max, running sum
+        for (int64_t a = 0; a < nqp; ++a) {
+            float * st0 = acc + (a*hpt - h0)*SD;
+            for (int64_t h = h0; h < h1; ++h) {
+                float * st = st0 + h*SD;
+                memset(st, 0, Dv*sizeof(float));
+                st[Dv] = -INFINITY; st[Dv + 1] = 0.0f;
+            }
+        }
+
+        FAP(FAP_SETUP);
+        for (int64_t rb = r0; rb < r1; rb += BR) {
+            const int nb = (int) MIN(BR, r1 - rb), nb4 = (nb + 3) & ~3;
+            // convert the block (padded to a multiple of 4 with copies of its last row)
+            const float * Kb = Kt;
+            if (shconv) {
+                Kb = kc + (rb - r0)*Dk;
+            } else {
+                for (int j = 0; j < nb4; ++j) {
+                    const int64_t ic = rows[rb + MIN(j, nb - 1)];
+                    ggml_fa_f16_to_f32_row(ggml_fa_mqa_row(k, kl, ic), Kt + j*Dk, Dk);
+                    if (!kv_same) {
+                        ggml_fa_f16_to_f32_row(ggml_fa_mqa_row(v, vl, ic), Vt + j*Dv, Dv);
+                    }
+                }
+            }
+            const float * Vr = kv_same ? Kb : Vt;
+            FAP(FAP_CONV);
