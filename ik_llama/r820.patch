--- a/common/sampling.cpp
+++ b/common/sampling.cpp
@@ -1313,12 +1313,49 @@ static float prob_avx2(int n, const float * logits, float max_val) {
     return 1.0f/sumf;
 }
 #endif
+#if defined(__SSE2__)
+// prob_avx2 for CPUs without AVX2/FMA: the same exp polynomial, 4 wide, without fused multiply-adds.
+// Inputs are <= 0 (logit - max), and clamping at -87 keeps 2^n a normal float (each term < 2e-38).
+static float prob_sse2(int n, const float * logits, float max_val) {
+    const __m128 r     = _mm_set1_ps(0x1.8p23f);
+    const __m128 max_v = _mm_set1_ps(max_val);
+    const __m128 lo    = _mm_set1_ps(-87.0f);
+    __m128 sum_v = _mm_setzero_ps();
+    int i = 0;
+    for (; i + 3 < n; i += 4) {
+        const __m128 x  = _mm_max_ps(_mm_sub_ps(_mm_loadu_ps(logits + i), max_v), lo);
+        const __m128 z  = _mm_add_ps(_mm_mul_ps(x, _mm_set1_ps(0x1.715476p+0f)), r);
+        const __m128 nn = _mm_sub_ps(z, r);
+        const __m128 b  = _mm_sub_ps(_mm_sub_ps(x, _mm_mul_ps(nn, _mm_set1_ps(0x1.62e4p-1f))),
+                                     _mm_mul_ps(nn, _mm_set1_ps(0x1.7f7d1cp-20f)));
+        const __m128 k  = _mm_castsi128_ps(_mm_add_epi32(_mm_slli_epi32(_mm_castps_si128(z), 23),
+                                                         _mm_castps_si128(_mm_set1_ps(1))));
+        const __m128 u  = _mm_mul_ps(b, b);
+        const __m128 hi = _mm_add_ps(_mm_mul_ps(_mm_set1_ps(0x1.0e4020p-7f), b), _mm_set1_ps(0x1.573e2ep-5f));
+        const __m128 mid = _mm_add_ps(_mm_mul_ps(_mm_set1_ps(0x1.555e66p-3f), b), _mm_set1_ps(0x1.fffdb6p-2f));
+        const __m128 j  = _mm_add_ps(_mm_mul_ps(_mm_add_ps(_mm_mul_ps(hi, u), mid), u),
+                                     _mm_mul_ps(_mm_set1_ps(0x1.ffffecp-1f), b));
+        sum_v = _mm_add_ps(sum_v, _mm_add_ps(_mm_mul_ps(j, k), k));
+    }
+    alignas(16) float buf[4];
+    _mm_store_ps(buf, sum_v);
+    float sumf = (buf[0] + buf[1]) + (buf[2] + buf[3]);
+    for (; i < n; ++i) {
+        sumf += expf(logits[i] - max_val);
+    }
+    return 1.0f/sumf;
+}
+#endif
 static float prob_scalar(int n, const float * logits, float max_val) {
+#if defined(__SSE2__)
+    return prob_sse2(n, logits, max_val);
+#else
     double sum_exp = 0.0;
     for (int i = 0; i < n; ++i) {
         sum_exp += exp((double)(logits[i] - max_val));
     }
     return (float)(1./sum_exp);
+#endif
 }
 
