+
+// the expert slots and pool, allocated again after vram_to_decode freed them
+static void moe_gpu_realloc(moe_gpu_state & st) {
+    ggml_cuda_set_device(st.ctx->device);
+    if (!st.wbuf) {
+        st.wbuf = ggml_backend_buft_alloc_buffer(ggml_backend_cuda_buffer_type(st.ctx->device), st.n_slots*st.slot_bytes);
+        if (!st.wbuf) {
+            GGML_CUDA_LOG_WARN("%s: no room for %d expert slots, GGML_MOE_GPU off\n", __func__, st.n_slots);
+            st.ok = false;
+            return;
+        }
+        CUDA_CHECK(cudaMemset(ggml_backend_buffer_get_base(st.wbuf), 0, st.n_slots*st.slot_bytes));
+    }
+    if (st.n_pool > 0 && !st.pbuf) {
+        st.pbuf = ggml_backend_buft_alloc_buffer(ggml_backend_cuda_buffer_type(st.ctx->device), st.n_pool*st.slot_bytes);
+        if (!st.pbuf) {
+            GGML_CUDA_LOG_WARN("%s: no room for a pool of %d experts\n", __func__, st.n_pool);
+        } else {
+            CUDA_CHECK(cudaMemset(ggml_backend_buffer_get_base(st.pbuf), 0, st.n_pool*st.slot_bytes));
+        }
+    }
+    st.pool_layer = nullptr;
+}
+
+// the dense split's weights freed; its budget is measured again at the next decode
+static void vram_free_dense() {
+    auto & d = dense_gpu_get();
+    if (d.on && !d.dev_w.empty()) {
+        dense_gpu_stop(d);
+        ggml_cuda_set_device(0);
+        CUDA_CHECK(cudaStreamSynchronize(d.stream));
+        for (void * w : d.dev_w) {
+            CUDA_CHECK(cudaFree(w));
+        }
+        d.dev_w.clear();
+        d.w.clear();
+        d.chain_w.clear();
+        d.n_w  = 0;
+        d.used = 0;
+    }
+    d.budget_set = false;
+}
+
+// a prompt: the dense split's weights out, the compute buffers and the expert path's buffers in
+static void vram_to_prompt(ggml_backend_cuda_context * ctx) {
+    if (!vram_switch_on()) {
+        return;
+    }
+    if (ctx && std::find(g_vram_ctx.begin(), g_vram_ctx.end(), ctx) == g_vram_ctx.end()) {
+        g_vram_ctx.push_back(ctx);
+    }
+    if (g_vram_mode == 1) {
+        return;
+    }
+    const int64_t t0 = ggml_time_us();
+    vram_free_dense();
+    for (ggml_backend_buffer_t b : g_vram_bufs) {
+        auto * c = (ggml_backend_cuda_buffer_context *) b->context;
+        if (c->evicted) {
+            ggml_cuda_set_device(c->device);
+            CUDA_CHECK(ggml_cuda_device_malloc(&c->dev_ptr, c->size, c->device));
+            c->evicted = false;
+        }
+    }
+    auto & m = g_moe_gpu;
+    if (m.init && m.ok) {
+        moe_gpu_realloc(m);
+    }
+    g_vram_mode = 1;
+    g_vram_switch_us += ggml_time_us() - t0;
+    vram_log("to the prompt", t0);
+}
+
+// decoding: the expert path's buffers and the CUDA pools out; the dense split measures what is left
+static void vram_to_decode() {
+    if (!vram_switch_on() || g_vram_mode == 2) {
+        return;
+    }
+    const int64_t t0 = ggml_time_us();
+    auto & m = g_moe_gpu;
+    if (m.init && m.ok && m.pending) {
+        GGML_CUDA_LOG_WARN("%s: the expert path has rows pending, its buffers stay\n", __func__);
+    }
+    if (m.init && m.ok && !m.pending) {
+        {
+            std::unique_lock<std::mutex> lock(m.mtx);
+            m.cv.wait(lock, [&m] { return m.job_done; });
+            m.pool_stop = true;
+            m.cv.wait(lock, [&m] { return !m.pool_busy; });
+            m.pool_stop = false;
+        }
+        ggml_cuda_set_device(m.ctx->device);
+        CUDA_CHECK(cudaDeviceSynchronize());
+        for (ggml_backend_buffer_t * b : { &m.wbuf, &m.pbuf, &m.sbuf, &m.abuf }) {
+            if (*b) {
+                ggml_backend_buffer_free(*b);
+                *b = nullptr;
+            }
+        }
+        m.sbuf_size = 0;
+        m.staged.clear();
+        m.stage_list.clear();
+        m.pool_layer = nullptr;
+        m.ctx->pools[m.ctx->device].reset();
+    }
+    for (ggml_backend_cuda_context * ctx : g_vram_ctx) {
+        ggml_cuda_set_device(ctx->device);
+        CUDA_CHECK(cudaDeviceSynchronize());
+        ctx->pools[ctx->device].reset();
+    }
+    // compute buffers: allocated again when a prompt's graph is placed in them (ggml_backend_cuda_buffer_get_base)
+    for (ggml_backend_buffer_t b : g_vram_bufs) {
+        auto * c = (ggml_backend_cuda_buffer_context *) b->context;
+        if (!c->evicted && ggml_backend_buffer_get_usage(b) == GGML_BACKEND_BUFFER_USAGE_COMPUTE && c->size >= (16u << 20)) {
+            ggml_cuda_set_device(c->device);
+            CUDA_CHECK(cudaDeviceSynchronize());
+            CUDA_CHECK(cudaFree(c->dev_ptr));
+            c->dev_ptr = nullptr;
+            c->evicted = true;
+        }
+    }
+    dense_gpu_get().budget_set = false;
+    g_vram_mode = 2;
+    g_vram_switch_us += ggml_time_us() - t0;
+    vram_log("to decoding", t0);
+}
+
+// spin until the GPU has finished every job posted (the kernel is started again if it timed out)
+static void dense_gpu_wait_seq(dense_gpu_state & st, int seq, bool restart) {
+    for (int64_t i = 1; (int) (st.mbox->done - seq) < 0; ++i) {
+        dense_gpu_pause();
+        if (restart && i % 4096 == 0 && (int) (st.mbox->done - seq) < 0 && dense_gpu_exited(st)) {
+            dense_gpu_start(st);
+        }
+    }
+}
+
+// NUMA node of the page at p (-1 if unknown)
+static int dense_gpu_node(const void * p) {
+    void * page = (void *) ((uintptr_t) p & ~(uintptr_t) 4095);
+    int status = -1;
+    return syscall(SYS_move_pages, 0, 1, &page, nullptr, &status, 0) == 0 ? status : -1;
+}
+
+static bool dense_gpu_is_pinned(const ggml_tensor * t) {
+    return t->buffer && ggml_backend_buffer_get_type(t->buffer) == ggml_backend_cuda_host_buffer_type();
+}
+
+char * ggml_cuda_dense_qbuf(size_t size, int vec_dot_type) {
+    auto & st = dense_gpu_get();
+    return st.on && (vec_dot_type == GGML_TYPE_Q8_0_X4 || vec_dot_type == GGML_TYPE_Q8_2_X4) && size <= st.qbuf_size ? st.qbuf : nullptr;
+}
+
+static long long g_bt[6], g_bt2[4], g_bth[8];
+static inline long long __rdtsc_bt() { unsigned lo, hi; __asm__ __volatile__("rdtsc" : "=a"(lo), "=d"(hi)); return ((long long) hi << 32) | lo; }
+static void g_bt_print(void) {
+    const double c = g_bt[5] ? g_bt[5]*2.4e3 : 1;
+    fprintf(stderr, "btime get %.1f checks %.1f find %.1f us; hist <1 %lld <5 %lld <20 %lld <50 %lld <100 %lld <200 %lld <1000 %lld more %lld\n", g_bt2[0]/c, g_bt2[1]/c, g_bt2[2]/c,
+        g_bth[0], g_bth[1], g_bth[2], g_bth[3], g_bth[4], g_bth[5], g_bth[6], g_bth[7]);
+    fprintf(stderr, "btime n %lld: checks+find %.1f us, wait_seq %.1f us, exited+start %.1f us, starts %lld, waited %lld\n", g_bt[5], g_bt[0]/c, g_bt[1]/c, g_bt[2]/c, g_bt[3], g_bt[4]);
+}
+bool ggml_cuda_dense_begin(const ggml_tensor * dst, int n_nodes, int64_t * gpu_rows) {
+    if (dense_gpu_waits_for_prompt()) {
+        return false;
+    }
+    static const bool bt_on = [] { const char * e = getenv("GGML_QTIME"); if (e && atoi(e)) { atexit(g_bt_print); return true; } return false; }();
+    const long long b0 = bt_on ? __rdtsc_bt() : 0;
+    auto & st = dense_gpu_get();
+    const long long a1 = bt_on ? __rdtsc_bt() : 0;
+    const ggml_tensor * src0 = dst->src[0], * src1 = dst->src[1];
+    if (!st.on || src0->type != GGML_TYPE_Q6_K || n_nodes < 1 || n_nodes > 8 || src1->ne[1] < 1 || src1->ne[1] > 8 ||
+        src0->ne[0] % 256 != 0 || !dense_gpu_is_pinned(dst)) {
+        return false;
+    }
+    if (vram_switch_on() && g_vram_mode != 2) {
+        vram_to_decode();
+    }
+    if (!st.budget_set) {
+        dense_gpu_size_budget(st);
+    }
+    const long long a2 = bt_on ? __rdtsc_bt() : 0;
+    auto it = st.w.find(src0->data);
+    if (bt_on) { const long long a3 = __rdtsc_bt(); g_bt2[0] += a1 - b0; g_bt2[1] += a2 - a1; g_bt2[2] += a3 - a2;
+        const double us = (a3 - b0)/2.4e3; g_bth[us < 1 ? 0 : us < 5 ? 1 : us < 20 ? 2 : us < 50 ? 3 : us < 100 ? 4 : us < 200 ? 5 : us < 1000 ? 6 : 7]++; }
+    if (it == st.w.end()) {
+        if (st.debug && st.w.empty()) {
+            fprintf(stderr, "dense_gpu: dst %p on node %d, qbuf on node %d\n", dst->data, dense_gpu_node(dst->data), dense_gpu_node(st.qbuf));
+        }
+        dense_gpu_weight e;
+        e.n_nodes = n_nodes;
+        e.on = dense_gpu_register(st, e, src0, n_nodes);
+        it = st.w.emplace(src0->data, e).first;
+    }
+    const dense_gpu_weight & e = it->second;
+    if (!e.on || e.n_nodes != n_nodes) {
+        return false;
+    }
+    const long long b1 = bt_on ? __rdtsc_bt() : 0;
+    if (bt_on && (int) (st.mbox->done - st.seq) < 0) g_bt[4]++;
+    dense_gpu_wait_seq(st, st.seq, true);
+    const long long b2 = bt_on ? __rdtsc_bt() : 0;
+    if (dense_gpu_exited(st)) {
+        dense_gpu_start(st);
+        g_bt[3]++;
+    }
+    if (bt_on) { const long long b3 = __rdtsc_bt(); g_bt[0] += b1 - b0; g_bt[1] += b2 - b1; g_bt[2] += b3 - b2; g_bt[5]++; }
+    st.mbox->job.w = e.idx;
+    int64_t total = 0;
+    for (int k = 0; k < n_nodes; ++k) {
+        gpu_rows[k] = e.gpu_rows[k];
+        total += e.gpu_rows[k];
+    }
+    if (st.debug > 2) {
+        st.cur = src0->name;
+        st.cur_bytes = total*src0->nb[1];
+    }
+    return true;
+}
+
+void ggml_cuda_dense_post(const ggml_tensor * dst, size_t row_size, int vec_dot_type) {
+    auto & st = dense_gpu_get();
+    const ggml_tensor * src1 = dst->src[1];
+    dense_gpu_job & job = st.mbox->job;
+    job.xq       = st.qbuf_dev;
+    job.y        = (float *) dst->data;
+    job.row_size = (long long) row_size;
+    job.ldy      = dst->nb[1]/sizeof(float);
+    job.s2y      = dst->nb[2]/sizeof(float);
+    job.ncols    = (int) src1->ne[1];
+    job.n_set    = (int) src1->ne[2];
+    job.xbf16    = vec_dot_type == GGML_TYPE_Q8_2_X4;
+    job.w2       = -1;
+    if (st.debug > 2) {
+        st.t_post = dense_gpu_now_ns();
+    }
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    st.mbox->seq = ++st.seq;
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+}
+
+char * ggml_cuda_dense_chain_qbuf(size_t size, int vec_dot_type) {
+    auto & st = dense_gpu_get();
+    return st.on && st.chain && (vec_dot_type == GGML_TYPE_Q8_0_X4 || vec_dot_type == GGML_TYPE_Q8_2_X4) && size <= st.cqbuf_size ? st.cqbuf : nullptr;
+}
+
+bool ggml_cuda_dense_chain_post(const ggml_tensor * ug, const ggml_tensor * down, size_t row_size, int vec_dot_type) {
+    if (dense_gpu_waits_for_prompt()) {
+        return false;
+    }
+    auto & st = dense_gpu_get();
+    const ggml_tensor * up = ug->src[0], * gate = ug->src[1], * x = ug->src[2], * wdn = down->src[0];
+    const int64_t nff = up->ne[1], ncols = x->ne[1];
+    if (!st.on || !st.chain || ug->op != GGML_OP_FUSED_UP_GATE || ((const int32_t *) ug->op_params)[0] != GGML_UNARY_OP_SILU ||
+        down->op != GGML_OP_MUL_MAT || down->src[1] != ug || ncols < 1 || ncols > 8 || x->ne[2] != 1 || x->ne[3] != 1 ||
+        up->ne[0] % 256 != 0 || wdn->ne[0] != nff || nff % 256 != 0 || 2*nff*ncols > st.d_h_size || !ggml_is_contiguous(ug) ||
+        down->ne[1] != ncols || down->ne[2] != 1 || !dense_gpu_is_pinned(down) ||
+        (vec_dot_type != GGML_TYPE_Q8_0_X4 && vec_dot_type != GGML_TYPE_Q8_2_X4)) {
+        return false;
+    }
+    if (vram_switch_on() && g_vram_mode != 2) {
+        vram_to_decode();
+    }
+    if (!st.budget_set) {
+        dense_gpu_size_budget(st);
+    }
+    auto it = st.chain_w.find(up->data);
+    if (it == st.chain_w.end()) {
+        std::array<int, 2> idx = {-1, -1};
+        const size_t bytes = (size_t) (2*nff/4*(up->ne[0]/256) + wdn->ne[1]/4*(nff/256))*DENSE_GPU_G4;
+        if (st.used + bytes <= st.budget) {
+            const ggml_tensor * ugt[2] = {up, gate};
+            idx[0] = dense_gpu_register_whole(st, ugt, 2);
+            idx[1] = idx[0] >= 0 ? dense_gpu_register_whole(st, &wdn, 1) : -1;
+        }
+        it = st.chain_w.emplace(up->data, idx).first;
+    }
+    if (it->second[0] < 0 || it->second[1] < 0) {
+        return false;
+    }
+    dense_gpu_wait_seq(st, st.seq, true);
+    if (dense_gpu_exited(st)) {
+        dense_gpu_start(st);
+    }
+    dense_gpu_job & job = st.mbox->job;
+    job.xq       = st.cqbuf_dev;
+    job.y        = st.d_h;
+    job.row_size = (long long) row_size;
+    job.ldy      = 2*nff;
+    job.s2y      = 0;
+    job.ncols    = (int) ncols;
+    job.n_set    = 1;
+    job.w        = it->second[0];
+    job.xbf16    = vec_dot_type == GGML_TYPE_Q8_2_X4;
+    job.w2       = it->second[1];
+    job.limit    = *(const float *) (ug->op_params + 1);
+    job.y2       = (float *) down->data;
+    job.ldy2     = down->nb[1]/sizeof(float);
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    st.mbox->seq = ++st.seq;
+    st.chain_seq = st.seq;
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    if (st.debug > 2) {
+        st.cur_bytes = (int64_t) (ggml_nbytes(up) + ggml_nbytes(gate) + ggml_nbytes(wdn));
+    }
+    return true;
+}
+
+void ggml_cuda_dense_chain_wait(int ith) {
+    auto & st = dense_gpu_get();
+    const int64_t t0 = st.debug > 2 && ith == 0 ? dense_gpu_now_ns() : 0;
+    dense_gpu_wait_seq(st, st.chain_seq, ith == 0);
+    if (st.debug > 2 && ith == 0) {
+        // for a chain: the CPU's wait at the first reader, then the GPU's copy and compute
+        auto & a = st.prof["shexp chain (wait)"];
+        a[0] += 1;
+        a[1] += dense_gpu_now_ns() - t0;
+        a[2] += st.mbox->t[1] - st.mbox->t[0];
+        a[3] += st.mbox->t[2] - st.mbox->t[1];
+        a[4] += st.cur_bytes;
+    }
+}
+
+void ggml_cuda_dense_end(void) {
+    auto & st = dense_gpu_get();
+    const int64_t t0 = st.debug > 1 ? ggml_time_us() : 0;
+    for (int64_t i = 1; st.mbox->done != st.seq; ++i) {
+        dense_gpu_pause();
+        // the kernel may have timed out as the job came in: start it again
+        if (i % 4096 == 0 && st.mbox->done != st.seq && dense_gpu_exited(st)) {
+            dense_gpu_start(st);
+        }
+    }
+    if (st.debug > 2) {
+        std::string n = st.cur;
+        if (n.rfind("blk.", 0) == 0 && n.find('.', 4) != std::string::npos) {
+            n = n.substr(n.find('.', 4) + 1);
+        }
+        auto & a = st.prof[n];
+        a[0] += 1;
+        a[1] += dense_gpu_now_ns() - st.t_post;
+        a[2] += st.mbox->t[1] - st.mbox->t[0];
+        a[3] += st.mbox->t[2] - st.mbox->t[1];
+        a[4] += st.cur_bytes;
+    }
+    if (st.debug > 1) {
+        st.t_wait += ggml_time_us() - t0;
+        if (++st.n_calls % 2000 == 0) {
+            fprintf(stderr, "dense_gpu: %lld calls, wait %.1f us per call, %lld kernel starts\n", (long long) st.n_calls,
+                    st.t_wait/2000.0, (long long) st.n_start);
+            st.t_wait = 0;
+            if (st.debug > 2 && st.n_calls % 10000 == 0) {
+                for (auto & kv : st.prof) {
+                    const auto & a = kv.second;
+                    fprintf(stderr, "dense_gpu: %-28s %6.0f calls, post to done %6.1f us, copy %5.1f us, compute %6.1f us, %5.1f GB/s\n",
+                            kv.first.c_str(), a[0], a[1]/a[0]/1e3, a[2]/a[0]/1e3, a[3]/a[0]/1e3, a[4]/a[3]);
+                }
+                st.prof.clear();
+                if (st.mbox->clk[1]) {
+                    fprintf(stderr, "dense_gpu: SM clock %.0f MHz while computing\n", 1e3*st.mbox->clk[0]/st.mbox->clk[1]);
+                }
+            }
+        }
+    }
+}
