+        const float * xr = wsum + t*ne0;
+              float * mr = (float *)((char *)ma->data + t*ma->nb[1]);
+              float * yr = (float *)((char *)nm->data + t*nm->nb[1]);
+        ggml_float sum = 0.0;
+        for (int j = 0; j < nth; ++j) sum += part[t*nth + j];
+        const float scale = 1.0f/sqrtf((float)(sum/ne0) + eps);
+        for (int64_t j = k0; j < k1; ++j) mr[j] = xr[j];
