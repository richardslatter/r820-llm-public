+    const size_t off[3] = { 0, st.off_gate, st.off_down };
+    for (int i = 0; i < n && L.cnt[ord[i]] >= st.pool_min && !st.pool_stop; ++i) {
+        const int e = ord[i];
+        char * ws = pbase + i*st.slot_bytes;
+        int k = 0;
+        for (; k < 3 && !st.pool_stop; ++k) {
+            CUDA_CHECK(cudaMemcpyAsync(ws + off[k], (const char *) w[k]->data + e*w[k]->nb[2], w[k]->nb[2], cudaMemcpyHostToDevice, st.copy_stream));
+            CUDA_CHECK(cudaEventRecord(st.ev_pool, st.copy_stream));
+            CUDA_CHECK(cudaEventSynchronize(st.ev_pool));
+        }
+        if (k == 3) {
+            st.pool_slot[e] = i;
+            used++;
+        }
+    }
+    if (used > 0) {
+        st.pool_layer = it->first;
+    }
+}
+
+// the job's stage list, behind the experts in the copy stream, once the splits copied the previous one
+static void moe_gpu_stage_upload(moe_gpu_state & st) {
+    if (st.stage_list.empty() || !st.sbuf) {
+        return;
+    }
+    char * sbase = (char *) ggml_backend_buffer_get_base(st.sbuf);
+    CUDA_CHECK(cudaStreamWaitEvent(st.copy_stream, st.ev_stage_free, 0));
+    size_t off = 0;
+    for (size_t k = 0; k < st.stage_list.size(); ++k) {
+        const ggml_tensor * w = st.stage_list[k];
+        CUDA_CHECK(cudaMemcpyAsync(sbase + off, w->data, ggml_nbytes(w), cudaMemcpyHostToDevice, st.copy_stream));
+        CUDA_CHECK(cudaEventRecord(st.stage_ev[k], st.copy_stream));
+        st.staged[w] = { off, (int) k };
+        off += GGML_PAD(ggml_nbytes(w), 256);
+    }
+    if (st.debug) {
+        fprintf(stderr, "moe_gpu stage: %d weights, %.1f MB\n", (int) st.stage_list.size(), off/1e6);
+    }
+}
+
+static void moe_gpu_run(moe_gpu_state & st) {
+    const int64_t t0 = ggml_time_us();
+    const ggml_tensor * ug = st.ug, * down = st.down;
+    const ggml_tensor * w_up = ug->src[0], * w_gate = ug->src[1], * w_down = down->src[0];
+    const ggml_tensor * b = ug->src[2];
+    const int n_sel   = (int) st.sel.size();
+    const int n_pairs = st.seg[n_sel];
+    const int64_t ne0  = w_up->ne[0];   // n_embd
+    const int64_t n_ff = w_up->ne[1];
+    const int64_t n_out = w_down->ne[1];
+    int max_ne = 0;
+    for (int j = 0; j < n_sel; ++j) {
+        max_ne = std::max(max_ne, st.seg[j + 1] - st.seg[j]);
+    }
+
+    // activations: B (src1 as uploaded), pair rows, X (gathered rows of one expert), U, G, P, D (all pairs)
+    auto pad = [](size_t n) { return GGML_PAD(n, 256); };
+    const size_t sz_b = pad(ggml_nbytes(b)), sz_r = pad(n_pairs*sizeof(int32_t)), sz_x = pad(ne0*max_ne*sizeof(float)),
+                 sz_f = pad(n_ff*max_ne*sizeof(float)), sz_d = pad(n_out*n_pairs*sizeof(float));
+    const int64_t n_cpu = st.defer ? (int64_t) st.rows.size() - n_pairs : 0;
+    const size_t sz_s = pad(n_out*n_cpu*sizeof(float)), sz_i = st.defer ? pad(st.rows.size()*sizeof(int32_t)) : 0;
+    const size_t need = sz_b + sz_r + sz_x + 3*sz_f + sz_d + sz_s + sz_i;
+    if (!st.abuf || ggml_backend_buffer_get_size(st.abuf) < need) {
+        if (st.abuf) {
+            ggml_backend_buffer_free(st.abuf);
+        }
+        st.abuf = ggml_backend_buft_alloc_buffer(ggml_backend_cuda_buffer_type(st.ctx->device), need + need/4);
+        GGML_ASSERT(st.abuf);
+    }
+    char * a = (char *) ggml_backend_buffer_get_base(st.abuf);
+    float   * d_b = (float *) a;              a += sz_b;
+    int32_t * d_r = (int32_t *) a;            a += sz_r;
+    float   * d_x = (float *) a;              a += sz_x;
+    float   * d_u = (float *) a;              a += sz_f;
+    float   * d_g = (float *) a;              a += sz_f;
+    float   * d_p = (float *) a;              a += sz_f;
+    float   * d_d = (float *) a;              a += sz_d;
+    st.d_d     = d_d;
+    st.d_stage = (float *) a;                 a += sz_s;
+    st.d_rows  = (int32_t *) a;
+
+    cudaStream_t stream = st.ctx->stream();
+    CUDA_CHECK(cudaMemcpyAsync(d_b, b->data, ggml_nbytes(b), cudaMemcpyHostToDevice, stream));
+    CUDA_CHECK(cudaMemcpyAsync(d_r, st.pair_row.data(), n_pairs*sizeof(int32_t), cudaMemcpyHostToDevice, stream));
+    if (st.defer) {
+        CUDA_CHECK(cudaMemcpyAsync(st.d_rows, st.rows.data(), st.rows.size()*sizeof(int32_t), cudaMemcpyHostToDevice, stream));
+    }
+    const float limit = *(const float *)(ug->op_params + 1);
+    char * wbase = (char *) ggml_backend_buffer_get_base(st.wbuf);
+    char * pbase = st.pbuf ? (char *) ggml_backend_buffer_get_base(st.pbuf) : nullptr;
+    int n_ring = 0, n_pooled = 0, pooled_pairs = 0;
+    for (int j = 0; j < n_sel; ++j) {
+        const int e = st.sel[j];
+        int slot = -1;
+        char * ws;
+        if (st.sel_pool[j] >= 0) {
+            // prefetched (the worker waited for its uploads)
+            ws = pbase + st.sel_pool[j]*st.slot_bytes;
+            n_pooled++;
+            pooled_pairs += st.seg[j + 1] - st.seg[j];
+        } else {
+            slot = n_ring % st.n_slots;
+            ws = wbase + slot*st.slot_bytes;
+            if (n_ring++ >= st.n_slots) {
+                CUDA_CHECK(cudaStreamWaitEvent(st.copy_stream, st.ev_free[slot], 0));
+            }
+            CUDA_CHECK(cudaMemcpyAsync(ws,               (const char *) w_up->data   + e*w_up->nb[2],   w_up->nb[2],   cudaMemcpyHostToDevice, st.copy_stream));
+            CUDA_CHECK(cudaMemcpyAsync(ws + st.off_gate, (const char *) w_gate->data + e*w_gate->nb[2], w_gate->nb[2], cudaMemcpyHostToDevice, st.copy_stream));
+            CUDA_CHECK(cudaMemcpyAsync(ws + st.off_down, (const char *) w_down->data + e*w_down->nb[2], w_down->nb[2], cudaMemcpyHostToDevice, st.copy_stream));
+            CUDA_CHECK(cudaEventRecord(st.ev_ready[slot], st.copy_stream));
+            CUDA_CHECK(cudaStreamWaitEvent(stream, st.ev_ready[slot], 0));
+        }
+
+        const int n_e = st.seg[j + 1] - st.seg[j];
+        k_moe_gpu_gather<<<n_e, 256, 0, stream>>>(d_b, d_r + st.seg[j], d_x, (int) ne0);
+        moe_gpu_mm(st, w_up,   ws,               d_x, n_e, d_u);
+        moe_gpu_mm(st, w_gate, ws + st.off_gate, d_x, n_e, d_g);
+        const int64_t n = n_ff*n_e;
+        k_moe_gpu_silu<<<(n + 255)/256, 256, 0, stream>>>(d_g, d_u, d_p, n, limit);
+        moe_gpu_mm(st, w_down, ws + st.off_down, d_p, n_e, d_d + (int64_t) st.seg[j]*n_out);
+        if (slot >= 0) {
+            CUDA_CHECK(cudaEventRecord(st.ev_free[slot], stream));
+        }
+    }
+    moe_gpu_stage_upload(st);
+    CUDA_CHECK(cudaEventRecord(st.ev_done, stream));
+    CUDA_CHECK(cudaEventSynchronize(st.ev_done));
+    const int64_t t1 = ggml_time_us();
+
+    if (st.defer) {
+        st.pending = true;
+    } else {
+        moe_gpu_fetch(st);
+    }
+    if (st.debug) {
+        fprintf(stderr, "moe_gpu %s: %d experts, %d pairs, pool %d experts %d pairs, gpu %.1f ms, %s %.1f ms\n", ug->name, n_sel, n_pairs,
+                n_pooled, pooled_pairs, (t1 - t0)/1e3, st.defer ? "deferred" : "scatter", (ggml_time_us() - t1)/1e3);
+    }
+}
+
+static void moe_gpu_worker() {
+    auto & st = g_moe_gpu;
+    ggml_cuda_set_device(st.ctx->device);
+    for (;;) {
+        std::unique_lock<std::mutex> lock(st.mtx);
+        st.cv.wait(lock, [&st] { return st.has_job; });
+        st.has_job = false;
+        lock.unlock();
+        moe_gpu_run(st);
+        lock.lock();
+        st.job_done  = true;
+        st.pool_busy = st.pbuf != nullptr;
+        st.cv.notify_all();
+        if (st.pool_busy) {
+            lock.unlock();
+            moe_gpu_prefetch(st);
+            lock.lock();
+            st.pool_busy = false;
+            st.cv.notify_all();
+        }
+    }
+}
+
+// GGML_DENSE_GPU_AFTER_PROMPT=1: the dense split takes its VRAM only once a prompt has set up the GPU expert path
+// (see dense_after_prompt_patch.py)
+static std::atomic<bool> g_moe_gpu_ready{false};
+static bool dense_gpu_waits_for_prompt() {
+    static const bool on = [] { const char * e = getenv("GGML_DENSE_GPU_AFTER_PROMPT"); return e && atoi(e) != 0; }();
+    return on && !g_moe_gpu_ready.load(std::memory_order_acquire);
+}
+
+static bool moe_gpu_init(moe_gpu_state & st, const ggml_tensor * ug, const ggml_tensor * down) {
+    if (st.init) {
+        return st.ok;
+    }
+    st.init = true;
+    auto envf = [](const char * name, float def) { const char * e = getenv(name); return e ? (float) atof(e) : def; };
+    st.c_cpu   = envf("GGML_MOE_GPU_C", st.c_cpu);
+    st.u_gpu   = envf("GGML_MOE_GPU_U", st.u_gpu);
+    st.g_gpu   = envf("GGML_MOE_GPU_G", st.g_gpu);
+    st.min_tok = (int) envf("GGML_MOE_GPU_MIN", (float) st.min_tok);
+    st.max_sel = (int) envf("GGML_MOE_GPU_MAX", (float) st.max_sel);
+    st.n_slots = std::max(2, (int) envf("GGML_MOE_GPU_SLOTS", (float) st.n_slots));
+    st.debug   = (int) envf("GGML_MOE_GPU_DEBUG", 0.0f);
+    st.defer_on = envf("GGML_MOE_GPU_DEFER", 1.0f) != 0.0f;
+    st.n_pool   = (int) envf("GGML_MOE_GPU_POOL", 48.0f);
+    st.pool_min = (int) envf("GGML_MOE_GPU_POOL_MIN", (float) st.pool_min);
+    st.stage_on = envf("GGML_MOE_GPU_STAGE", 1.0f) != 0.0f;
+
+    const int device = 0;
+    ggml_cuda_set_device(device);
+    st.ctx = new ggml_backend_cuda_context(device, nullptr);
+    st.ctx->fusion = 0; // ggml_cuda_mul_mat is called without a graph
+    CUDA_CHECK(cudaStreamCreateWithFlags(&st.copy_stream, cudaStreamNonBlocking));
+    // up, gate, down of one expert per slot; the padding after each stays zero
+    auto pad = [](size_t n) { return GGML_PAD(n + 512, 256); };
+    st.off_gate   = pad(ug->src[0]->nb[2]);
+    st.off_down   = st.off_gate + pad(ug->src[1]->nb[2]);
+    st.slot_bytes = st.off_down + pad(down->src[0]->nb[2]);
+    st.wbuf = ggml_backend_buft_alloc_buffer(ggml_backend_cuda_buffer_type(device), st.n_slots*st.slot_bytes);
+    if (!st.wbuf) {
+        GGML_CUDA_LOG_WARN("%s: no room for %d expert slots, GGML_MOE_GPU off\n", __func__, st.n_slots);
+        return false;
+    }
+    CUDA_CHECK(cudaMemset(ggml_backend_buffer_get_base(st.wbuf), 0, st.n_slots*st.slot_bytes));
+    st.ev_ready.resize(st.n_slots);
+    st.ev_free.resize(st.n_slots);
+    for (int i = 0; i < st.n_slots; ++i) {
+        CUDA_CHECK(cudaEventCreateWithFlags(&st.ev_ready[i], cudaEventDisableTiming));
+        CUDA_CHECK(cudaEventCreateWithFlags(&st.ev_free[i],  cudaEventDisableTiming));
+    }
+    CUDA_CHECK(cudaEventCreateWithFlags(&st.ev_done, cudaEventDisableTiming | cudaEventBlockingSync));
+    CUDA_CHECK(cudaEventCreateWithFlags(&st.ev_pool, cudaEventDisableTiming | cudaEventBlockingSync));
+    CUDA_CHECK(cudaEventCreateWithFlags(&st.ev_stage_free, cudaEventDisableTiming));
+    if (st.n_pool > 0) {
+        st.pbuf = ggml_backend_buft_alloc_buffer(ggml_backend_cuda_buffer_type(device), st.n_pool*st.slot_bytes);
+        if (!st.pbuf) {
+            GGML_CUDA_LOG_WARN("%s: no room for a pool of %d experts\n", __func__, st.n_pool);
+            st.n_pool = 0;
+        } else {
+            CUDA_CHECK(cudaMemset(ggml_backend_buffer_get_base(st.pbuf), 0, st.n_pool*st.slot_bytes));
+        }
+    }
+    std::thread(moe_gpu_worker).detach();
+    st.ok = true;
+    g_moe_gpu_ready.store(true, std::memory_order_release);
+    return true;
+}
+
+int ggml_cuda_moe_offload_begin(const ggml_tensor * ug, const ggml_tensor * down, uint32_t * skip_mask) {
+    auto & st = g_moe_gpu;
+    if (ug->op != GGML_OP_MOE_FUSED_UP_GATE || down->op != GGML_OP_MUL_MAT_ID || !ug->src[1] || ug->src[4] || ug->src[5] ||
+        ug->op_params[0] != GGML_UNARY_OP_SILU || down->src[1] != ug || down->src[2] != ug->src[3]) {
+        return 0;
+    }
+    const ggml_tensor * ids = ug->src[3];
+    const ggml_tensor * b   = ug->src[2];
+    const int cc = ggml_cuda_info().devices[0].cc;
+    if (ids->type != GGML_TYPE_I32 || b->type != GGML_TYPE_F32 || !ggml_is_contiguous(b) || b->ne[3] != 1 ||
+        ug->type != GGML_TYPE_F32 || down->type != GGML_TYPE_F32 || down->src[0]->ne[0] != ug->ne[0] ||
+        !ggml_cuda_should_use_mmq(ug->src[0]->type, cc, 64) || !ggml_cuda_should_use_mmq(down->src[0]->type, cc, 64) ||
+        ids->ne[1] < (st.init ? st.min_tok : 64) || ug->src[0]->ne[2] > 64*32) {
+        return 0;
+    }
+    vram_to_prompt(nullptr);
+    if (!moe_gpu_init(st, ug, down) || ids->ne[1] < st.min_tok) {
+        return 0;
+    }
+    {
+        std::unique_lock<std::mutex> lock(st.mtx);
+        st.cv.wait(lock, [&st] { return st.job_done; });
+        st.pool_stop = true;
+        st.cv.wait(lock, [&st] { return !st.pool_busy; });
+        st.pool_stop = false;
+    }
+
+    const int n_as = (int) ug->src[0]->ne[2];
+    const int n_used = (int) ids->ne[0];
+    const int64_t n_tok = ids->ne[1];
+    const int64_t ne11 = b->ne[1];
+    st.cnt.assign(n_as, 0);
+    int total = 0;
+    for (int64_t t = 0; t < n_tok; ++t) {
+        for (int k = 0; k < n_used; ++k) {
+            const int32_t e = *(const int32_t *)((const char *) ids->data + t*ids->nb[1] + k*ids->nb[0]);
+            if (e >= 0 && e < n_as) {
+                st.cnt[e]++;
+                total++;
+            }
+        }
+    }
+    // this layer's counts predict the next batch; the layer before learns which layer follows it
+    const void * key = ug->src[0]->data;
+    if (st.cur_layer && st.cur_layer != key) {
+        st.layers[st.cur_layer].next = key;
+    }
+    st.cur_layer = key;
+    {
+        auto & L = st.layers[key];
+        L.w_up   = ug->src[0];
+        L.w_gate = ug->src[1];
+        L.w_down = down->src[0];
+        L.cnt    = st.cnt;
+    }
+    // pooled experts cost no upload: they go first
+    const bool pooled = st.pool_layer == key && (int) st.pool_slot.size() == n_as;
+    std::vector<char> in_pool(n_as, 0);
+    int n_pre = 0, acc = 0;
+    double t_gpu = 0;
+    for (int a = 0; pooled && a < n_as; ++a) {
+        if (st.pool_slot[a] >= 0 && st.cnt[a] >= st.pool_min) {
+            in_pool[a] = 1;
+            n_pre++;
+            acc   += st.cnt[a];
+            t_gpu += std::max(0.05, (double) st.g_gpu*st.cnt[a]);
+        }
+    }
+    st.order.resize(n_as);
+    std::iota(st.order.begin(), st.order.end(), 0);
+    std::sort(st.order.begin(), st.order.end(), [&st, &in_pool](int x, int y) {
+        return in_pool[x] != in_pool[y] ? in_pool[x] > in_pool[y] : st.cnt[x] > st.cnt[y];
+    });
+    // then the busiest experts while the GPU (uploads, compute) stays ahead of the CPU time left
+    double best = std::max((double) st.c_cpu*(total - acc), t_gpu);
+    int n_best = n_pre;
+    for (int n = n_pre + 1; n <= std::min(n_as, st.max_sel + n_pre) && st.cnt[st.order[n - 1]] > 0; ++n) {
+        const int c = st.cnt[st.order[n - 1]];
+        acc   += c;
+        t_gpu += std::max((double) st.u_gpu, (double) st.g_gpu*c);
+        const double t = std::max((double) st.c_cpu*(total - acc), t_gpu);
+        if (t < best) {
+            best = t;
+            n_best = n;
+        }
+    }
+    if (n_best == 0) {
+        return 0;
+    }
+
+    std::vector<int> local(n_as, -1);
+    st.sel.assign(st.order.begin(), st.order.begin() + n_best);
+    st.sel_pool.resize(n_best);
+    for (int j = 0; j < n_best; ++j) {
+        st.sel_pool[j] = in_pool[st.sel[j]] ? st.pool_slot[st.sel[j]] : -1;
+    }
+    st.seg.assign(n_best + 1, 0);
+    for (int j = 0; j < n_best; ++j) {
+        local[st.sel[j]] = j;
+        st.seg[j + 1] = st.seg[j] + st.cnt[st.sel[j]];
+        skip_mask[st.sel[j] >> 5] |= 1u << (st.sel[j] & 31);
+    }
+    const int n_pairs = st.seg[n_best];
+    st.pair_row.resize(n_pairs);
+    st.pair_slot.resize(n_pairs);
+    st.pair_tok.resize(n_pairs);
+    std::vector<int32_t> pos(st.seg.begin(), st.seg.end() - 1);
+    for (int64_t t = 0; t < n_tok; ++t) {
+        for (int k = 0; k < n_used; ++k) {
+            const int32_t e = *(const int32_t *)((const char *) ids->data + t*ids->nb[1] + k*ids->nb[0]);
+            if (e < 0 || e >= n_as || local[e] < 0) {
+                continue;
+            }
+            const int p = pos[local[e]]++;
+            st.pair_row[p]  = (int32_t)((k % ne11) + t*ne11);
+            st.pair_slot[p] = k;
+            st.pair_tok[p]  = (int32_t) t;
+        }
+    }
+
+    st.defer = st.defer && st.defer_on && ggml_is_contiguous(down) && down->ne[0] % 4 == 0 &&
+               down->ne[1] == n_used && down->ne[2] == n_tok;
+    if (st.defer) {
+        const int64_t n_rows = n_used*n_tok;
+        std::vector<char> on_gpu(n_rows, 0);
+        st.rows.resize(n_rows);
+        for (int p = 0; p < n_pairs; ++p) {
+            st.rows[p] = st.pair_slot[p] + st.pair_tok[p]*n_used;
+            on_gpu[st.rows[p]] = 1;
+        }
+        int64_t q = n_pairs;
+        for (int64_t r = 0; r < n_rows; ++r) {
+            if (!on_gpu[r]) {
+                st.rows[q++] = (int32_t) r;
+            }
+        }
+    }
+
+    st.ug = ug;
+    st.down = down;
+    st.t_job = st.debug ? ggml_time_us() : 0;
+    {
+        std::lock_guard<std::mutex> lock(st.mtx);
+        st.job_done = false;
+        st.has_job  = true;
+    }
+    st.cv.notify_all();
+    return n_best;
+}
+
+void ggml_cuda_moe_offload_end(void) {
+    auto & st = g_moe_gpu;
+    const int64_t t0 = ggml_time_us();
+    std::unique_lock<std::mutex> lock(st.mtx);
+    st.cv.wait(lock, [&st] { return st.job_done; });
+    if (st.t_job) {
+        // the first wait after a job is the expert phase's end: the CPU's share took t0 - t_job
+        fprintf(stderr, "moe_gpu cpu %.1f ms, waited %.1f ms for the gpu\n", (t0 - st.t_job)/1e3, (ggml_time_us() - t0)/1e3);
+        st.t_job = 0;
+    }
+}
+
+void ggml_cuda_moe_offload_defer(bool defer) {
+    g_moe_gpu.defer = defer;
+}
+
+bool ggml_cuda_moe_offload_copy(const ggml_tensor * src, ggml_tensor * dst) {
+    auto & st = g_moe_gpu;
+    if (!st.pending || src != st.down) {
+        return false;
+    }
+    ggml_cuda_moe_offload_end();
+    const int64_t n_out = src->ne[0];
+    const size_t  row   = n_out*sizeof(float);
+    const int n_pairs = (int) st.pair_tok.size();
+    const int64_t n_cpu = (int64_t) st.rows.size() - n_pairs;
+    const int64_t t0 = ggml_time_us();
+    cudaStream_t stream = st.ctx->stream();
+    // the CPU rows: read by the kernel straight from pinned host memory where possible, else packed and uploaded
+    void * src_dev = nullptr;
+    if (n_cpu > 0 && cudaHostGetDevicePointer(&src_dev, src->data, 0) != cudaSuccess) {
+        cudaGetLastError();
+        src_dev = nullptr;
+    }
+    if (n_cpu > 0 && src_dev) {
+        k_moe_gpu_copy_rows<<<(unsigned) n_cpu, 256, 0, stream>>>((const float4 *) src_dev, st.d_rows + n_pairs, (float4 *) dst->data, (int) (n_out/4));
+    } else if (n_cpu > 0) {
+        moe_gpu_host_reserve(&st.h_stage, &st.h_stage_size, n_cpu*row);
+        for (int64_t i = 0; i < n_cpu; ++i) {
+            memcpy((char *) st.h_stage + i*row, (const char *) src->data + (int64_t) st.rows[n_pairs + i]*src->nb[1], row);
+        }
+        CUDA_CHECK(cudaMemcpyAsync(st.d_stage, st.h_stage, n_cpu*row, cudaMemcpyHostToDevice, stream));
+        k_moe_gpu_scatter<<<(unsigned) n_cpu, 256, 0, stream>>>((const float4 *) st.d_stage, st.d_rows + n_pairs, (float4 *) dst->data, (int) (n_out/4));
+    }
+    const int64_t t1 = ggml_time_us();
+    if (n_pairs > 0) {
+        k_moe_gpu_scatter<<<n_pairs, 256, 0, stream>>>((const float4 *) st.d_d, st.d_rows, (float4 *) dst->data, (int) (n_out/4));
+    }
+    CUDA_CHECK(cudaGetLastError());
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    st.pending = false;
+    if (st.debug) {
+        fprintf(stderr, "moe_gpu %s: %lld cpu rows %s in %.1f ms, merged in %.1f ms\n", src->name,
+                (long long) n_cpu, src_dev ? "mapped" : "packed", (t1 - t0)/1e3, (ggml_time_us() - t1)/1e3);
+    }
+    return true;
+}
+
+void ggml_cuda_moe_stage(const ggml_tensor ** weights, int n) {
+    auto & st = g_moe_gpu;
+    if (!st.init || !st.ok) {
+        return;
+    }
+    if (n > 0) {
+        vram_to_prompt(nullptr);
+    }
+    if (!st.ok) {
+        return;
+    }
+    ggml_cuda_moe_offload_end();
+    st.staged.clear();
+    st.stage_list.clear();
+    if (!st.stage_on || n <= 0) {
+        return;
+    }
+    size_t need = 0;
+    for (int k = 0; k < n; ++k) {
+        need += GGML_PAD(ggml_nbytes(weights[k]), 256);
+    }
+    if (need > st.sbuf_size) {
+        ggml_cuda_set_device(st.ctx->device);
+        if (st.sbuf) {
+            ggml_backend_buffer_free(st.sbuf);
+        }
+        st.sbuf = ggml_backend_buft_alloc_buffer(ggml_backend_cuda_buffer_type(st.ctx->device), need);
+        st.sbuf_size = st.sbuf ? need : 0;
+        if (!st.sbuf) {
+            GGML_CUDA_LOG_WARN("%s: no room to stage %.1f MB of weights\n", __func__, need/1e6);
+            st.stage_on = false;
+            return;
+        }
+    }
+    while ((int) st.stage_ev.size() < n) {
+        cudaEvent_t ev;
+        CUDA_CHECK(cudaEventCreateWithFlags(&ev, cudaEventDisableTiming));
+        st.stage_ev.push_back(ev);
+    }
+    st.stage_list.assign(weights, weights + n);
+}
+
+bool ggml_cuda_moe_stage_copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst) {
+    auto & st = g_moe_gpu;
+    if (!st.init || !ggml_backend_is_cuda(backend)) {
+        return false;
+    }
+    ggml_cuda_moe_offload_end();
+    auto it = st.staged.find(src);
+    if (it == st.staged.end() || ggml_nbytes(dst) != ggml_nbytes(src)) {
+        return false;
+    }
+    auto * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(ctx->device);
+    cudaStream_t stream = ctx->stream();
+    CUDA_CHECK(cudaStreamWaitEvent(stream, st.stage_ev[it->second.second], 0));
+    CUDA_CHECK(cudaMemcpyAsync(dst->data, (const char *) ggml_backend_buffer_get_base(st.sbuf) + it->second.first,
+                               ggml_nbytes(src), cudaMemcpyDeviceToDevice, stream));
+    CUDA_CHECK(cudaEventRecord(st.ev_stage_free, stream));
+    return true;
+}
+
+void ggml_cuda_moe_offload_flush(void) {
+    auto & st = g_moe_gpu;
+    if (!st.pending) {
+        return;
+    }
+    static bool warned = false;
+    if (!warned) {
+        warned = true;
+        GGML_CUDA_LOG_WARN("%s: deferred expert rows of %s were not copied to the GPU, fetching them\n", __func__, st.down->name);
+    }
+    ggml_cuda_moe_offload_end();
+    moe_gpu_fetch(st);
+    st.pending = false;
+}
+
+
+// ---- GGML_DENSE_GPU: the GPU share of small-batch dense matmuls computed on the CPU (see ggml-cuda.h) ----
+// GGML_DENSE_GPU core: a persistent kernel computes rows of Q6_K matmuls for jobs posted in pinned host memory.
+// The includer provides block_q6_K, half and CUDA_CHECK.
+//
+// Weights: the GPU rows of a matrix are repacked so that each 4-row group and 256-block is DENSE_GPU_G4
+// contiguous bytes: ql[4][128] qh[4][64] scales[4][16] d[4] (f32).
+// Activations: the CPU's Q8_0_X4 rows (per 128 values: 4 fp16 scales, 128 int8) or Q8_2_X4 rows (4 bf16 scales,
+// 4 sums, 128 int8) in pinned host memory.
+// A job: block 0 polls the mailbox, all blocks copy the activations to device memory (int8 and 16-bit scale per
+// 32), meet at a grid barrier, compute their share of the groups (one warp per group, 8 lanes per row, each
+// lane 32 weights of a block) and write the results to the pinned host dst; the last block sets mbox->done.
+// A chain job (w2 >= 0) is a whole FFN: w holds the up rows then the gate rows and writes a device buffer, then
+// h = silu(gate)*up is quantised on the GPU (int8, fp16 scale per 32) and w2 (down) writes the host dst.
+// The kernel exits after idle_ns without a job, or on a job with w < 0.
+
+#define DENSE_GPU_G4      848
+#define DENSE_GPU_MAX_SEG 16
+#define DENSE_GPU_SMEM    (48*1024 - 256) // dynamic shared memory per block (two blocks per SM)
+#define DENSE_GPU_THREADS 256
+#ifndef DENSE_GPU_PASSES
+#define DENSE_GPU_PASSES  4
+#endif
+
+struct dense_gpu_seg {
+    int g0;      // first group (in the weight's repacked groups)
+    int ngroups;
+    int i02;     // matrix of a 3D (grouped) weight
+    int ix0;     // its first row in that matrix
+};
+
+struct dense_gpu_wdesc {
+    const char * w;
+    int nb;      // 256-blocks per row
+    int n_seg;
+    int ngroups;
+    int pad;
+    dense_gpu_seg seg[DENSE_GPU_MAX_SEG];
+};
+
+struct dense_gpu_job {
+    const char * xq;   // Q8_0_X4 rows, row (set*ncols + col) at xq + row*row_size
+    float * y;         // y + i02*s2y + col*ldy + row
+    long long row_size;
+    long long ldy, s2y;
+    int ncols, n_set;
+    int w;             // weight table index, < 0: exit
+    int xbf16;         // activations: 0 Q8_0_X4, 1 Q8_2_X4
+    int w2;            // chain: the down weight (< 0: none); y is then device memory, [col][2*nff], up then gate
+    float limit;       // chain: silu(gate) <= limit and |up| <= limit if limit > 0
+    float * y2;        // chain: down's dst, y2 + col*ldy2 + row
+    long long ldy2;
+};
+static_assert(sizeof(dense_gpu_job) % 16 == 0, "dense_gpu_job is copied as int4");
+
+struct dense_gpu_mbox {
+    volatile int seq;   // host: last job posted
+    volatile int done;  // GPU: last job finished
+    volatile int state; // GPU: 1 running, 0 exiting
+    int pad;
+    dense_gpu_job job;
+    volatile unsigned long long t[3]; // GPU clock of the last job: seen, activations copied, finished
+    volatile unsigned long long clk[2]; // block 0 since the kernel started: SM cycles and ns computing
+};
+
+struct dense_gpu_dev {
+    unsigned int bar;   // grid barrier arrivals
+    unsigned int fin;   // finished blocks
+    volatile int cmd;   // jobs published by block 0
+    int seq;
+    dense_gpu_job job;
+};
+
+// all blocks of the grid; gen (thread 0 of each block) counts the arrivals expected so far
+static __device__ __forceinline__ void dense_gpu_grid_sync(dense_gpu_dev * dev, unsigned int & gen, int nblk) {
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        gen += nblk;
+        __threadfence();
+        atomicAdd(&dev->bar, 1);
+        while ((int) (*(volatile unsigned int *) &dev->bar - gen) < 0) {
+        }
+        __threadfence();
+    }
+    __syncthreads();
+}
+
+static __device__ __forceinline__ unsigned long long dense_gpu_ns() {
+    unsigned long long t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+    return t;
+}
+
+template <bool BF16>
+static __device__ __forceinline__ float dense_gpu_xscale(uint16_t s) {
+    return BF16 ? __uint_as_float((unsigned int) s << 16) : __half2float(__ushort_as_half(s));
+}
+
+// not inlined: inlined, its instantiations shared the persistent kernel's 128 registers and spilled (q_b's GPU rows
+// read at 91 GB/s against 108, wo_b's at 106 against 118)
+template <int NC, bool SMEM, bool BF16>
+static __device__ __noinline__ void dense_gpu_part(const dense_gpu_wdesc & wd, const dense_gpu_job & job, const int8_t * __restrict__ gxq,
+        const uint16_t * __restrict__ gxs, int ga, int gb, char * smem) {
+    const int nb = wd.nb, K = nb*256, n32 = K/32;
+    const int tid = threadIdx.x, lane = tid % 32, warp = tid/32, nwarps = blockDim.x/32;
+    int8_t * sxq = (int8_t *) smem;
+    uint16_t * sxs = (uint16_t *) (smem + NC*K);
+    float  * sy  = (float *) (smem + (SMEM ? NC*K + NC*n32*2 : 0));
+    // groups per pass: what fits, but at least DENSE_GPU_PASSES passes so that the results written to host memory
+    // after a pass go out while the next one computes
+    const int room = min((DENSE_GPU_SMEM - (SMEM ? NC*K + NC*n32*2 : 0))/(16*NC), max(32, (gb - ga + DENSE_GPU_PASSES - 1)/DENSE_GPU_PASSES));
+
+    const int g = lane/8, k = lane % 8;
+    const int h = k/4, j = k % 4;
+    const bool sw = k >= 4; // lanes 4..7 take the high nibbles first (no shared memory bank conflicts)
+    const int off1 = 128*h + 16*j + (sw ? 64 : 0), off2 = 128*h + 16*j + (sw ? 0 : 64);
+    const int i32a = off1/32, i32b = off2/32;
+    const int sl = j < 2 ? 0 : 2;
+    const int qs1 = sw ? 4 : 0, qs2 = sw ? 0 : 4;
+    const int hs1 = sl + qs1, hs2 = sl + qs2;
+    const uint32_t scsel = (uint32_t) ((j + (sw ? 4 : 0)) | ((j + (sw ? 0 : 4)) << 4));
+    const int o_ql = g*128 + k*16, o_qh = 512 + g*64 + (2*h + (j & 1))*16, o_sc = 768 + g*16 + h*8, o_d = 832 + g*4;
+
+    int loaded = -1;
+    for (int s = 0; s < wd.n_seg; ++s) {
+        const dense_gpu_seg sg = wd.seg[s];
+        const int a = max(ga, sg.g0), b = min(gb, sg.g0 + sg.ngroups);
+        if (a >= b) {
+            continue;
+        }
+        const int8_t * xq = gxq + (long long) sg.i02*NC*K;
+        const uint16_t * xs = gxs + (long long) sg.i02*NC*n32;
+        if (SMEM) {
+            if (sg.i02 != loaded) {
+                __syncthreads();
+                for (int i = tid; i < NC*K/16; i += blockDim.x) {
+                    ((int4 *) sxq)[i] = ((const int4 *) xq)[i];
+                }
+                for (int i = tid; i < NC*n32/8; i += blockDim.x) {
+                    ((int4 *) sxs)[i] = ((const int4 *) xs)[i];
+                }
+                __syncthreads();
+                loaded = sg.i02;
+            }
+            xq = sxq;
+            xs = sxs;
+        }
+        float * ys = job.y + sg.i02*job.s2y + sg.ix0;
+        for (int c0 = a; c0 < b; c0 += room) {
+            const int c1 = min(b, c0 + room);
+            for (int G = c0 + warp; G < c1; G += nwarps) {
+                float acc[NC];
+#pragma unroll
+                for (int c = 0; c < NC; ++c) {
+                    acc[c] = 0.f;
+                }
+                const char * base = wd.w + (long long) G*nb*DENSE_GPU_G4;
+                int4 ql = __ldg((const int4 *) (base + o_ql)), qh = __ldg((const int4 *) (base + o_qh));
+                int2 scw = __ldg((const int2 *) (base + o_sc));
+                float dw = __ldg((const float *) (base + o_d));
+                for (int ib = 0; ib < nb; ++ib) {
+                    int4 nql, nqh; int2 nscw; float ndw;
+                    if (ib + 1 < nb) {
+                        const char * nbp = base + (long long) (ib + 1)*DENSE_GPU_G4;
+                        nql = __ldg((const int4 *) (nbp + o_ql)); nqh = __ldg((const int4 *) (nbp + o_qh));
+                        nscw = __ldg((const int2 *) (nbp + o_sc)); ndw = __ldg((const float *) (nbp + o_d));
+                    }
+                    const int scp = (int) __byte_perm(scw.x, scw.y, scsel);
+                    const float f1 = dw*(float) (int8_t) (scp & 0xff), f2 = dw*(float) (int8_t) ((scp >> 8) & 0xff);
+                    const int qlv[4] = {ql.x, ql.y, ql.z, ql.w}, qhv[4] = {qh.x, qh.y, qh.z, qh.w};
+                    int w1[4], w2[4];
+#pragma unroll
+                    for (int i = 0; i < 4; ++i) {
+                        // 6-bit q in each byte, q - 32 as int8: set bit 7 so that no borrow crosses bytes, then flip it back
+                        w1[i] = ((((qlv[i] >> qs1) & 0x0F0F0F0F) | (((qhv[i] >> hs1) & 0x03030303) << 4) | 0x80808080) - 0x20202020) ^ 0x80808080;
+                        w2[i] = ((((qlv[i] >> qs2) & 0x0F0F0F0F) | (((qhv[i] >> hs2) & 0x03030303) << 4) | 0x80808080) - 0x20202020) ^ 0x80808080;
+                    }
+#pragma unroll
+                    for (int c = 0; c < NC; ++c) {
+                        const int8_t * xc = xq + (long long) c*K + ib*256;
+                        const uint16_t * sc = xs + c*n32 + ib*8;
+                        const int4 a1 = SMEM ? *(const int4 *) (xc + off1) : __ldg((const int4 *) (xc + off1));
+                        const int4 a2 = SMEM ? *(const int4 *) (xc + off2) : __ldg((const int4 *) (xc + off2));
+                        int s1 = __dp4a(w1[0], a1.x, 0); s1 = __dp4a(w1[1], a1.y, s1); s1 = __dp4a(w1[2], a1.z, s1); s1 = __dp4a(w1[3], a1.w, s1);
+                        int s2 = __dp4a(w2[0], a2.x, 0); s2 = __dp4a(w2[1], a2.y, s2); s2 = __dp4a(w2[2], a2.z, s2); s2 = __dp4a(w2[3], a2.w, s2);
+                        acc[c] = fmaf(f1*dense_gpu_xscale<BF16>(sc[i32a]), (float) s1, acc[c]);
+                        acc[c] = fmaf(f2*dense_gpu_xscale<BF16>(sc[i32b]), (float) s2, acc[c]);
+                    }
+                    if (ib + 1 < nb) {
+                        ql = nql; qh = nqh; scw = nscw; dw = ndw;
+                    }
+                }
+#pragma unroll
+                for (int c = 0; c < NC; ++c) {
+                    float v = acc[c];
+                    v += __shfl_xor_sync(0xffffffff, v, 1);
+                    v += __shfl_xor_sync(0xffffffff, v, 2);
+                    v += __shfl_xor_sync(0xffffffff, v, 4);
+                    acc[c] = v;
+                }
+                if (k < NC) {
+                    float v = acc[0];
+#pragma unroll
+                    for (int c = 1; c < NC; ++c) {
+                        if (k == c) {
+                            v = acc[c];
+                        }
+                    }
+                    sy[k*4*room + 4*(G - c0) + g] = v;
+                }
+            }
+            __syncthreads();
+            const int n = 4*(c1 - c0), r0 = 4*(c0 - sg.g0);
+            for (int c = 0; c < NC; ++c) {
+                for (int i = tid; i < n; i += blockDim.x) {
+                    ys[c*job.ldy + r0 + i] = sy[c*4*room + i];
+                }
+            }
+            __syncthreads();
+        }
+    }
+}
+
+template <int NC, bool BF16>
+static __device__ void dense_gpu_part_nc(const dense_gpu_wdesc & wd, const dense_gpu_job & job, const int8_t * gxq, const uint16_t * gxs,
+        int ga, int gb, char * smem) {
+    const int K = wd.nb*256;
+    // activations in shared memory if room is left for 64 groups of results
+    if (NC*K + NC*(K/32)*2 + 64*16*NC <= DENSE_GPU_SMEM) {
+        dense_gpu_part<NC, true, BF16>(wd, job, gxq, gxs, ga, gb, smem);
+    } else {
+        dense_gpu_part<NC, false, BF16>(wd, job, gxq, gxs, ga, gb, smem);
+    }
+}
+
+template <bool BF16>
+static __device__ void dense_gpu_part_x(const dense_gpu_wdesc & wd, const dense_gpu_job & job, const int8_t * gxq, const uint16_t * gxs,
+        int ga, int gb, char * smem) {
+    switch (job.ncols) {
+        case 1: dense_gpu_part_nc<1, BF16>(wd, job, gxq, gxs, ga, gb, smem); break;
+        case 2: dense_gpu_part_nc<2, BF16>(wd, job, gxq, gxs, ga, gb, smem); break;
+        case 3: dense_gpu_part_nc<3, BF16>(wd, job, gxq, gxs, ga, gb, smem); break;
+        case 4: dense_gpu_part_nc<4, BF16>(wd, job, gxq, gxs, ga, gb, smem); break;
+        case 5: dense_gpu_part_nc<5, BF16>(wd, job, gxq, gxs, ga, gb, smem); break;
+        case 6: dense_gpu_part_nc<6, BF16>(wd, job, gxq, gxs, ga, gb, smem); break;
+        case 7: dense_gpu_part_nc<7, BF16>(wd, job, gxq, gxs, ga, gb, smem); break;
+        default: dense_gpu_part_nc<8, BF16>(wd, job, gxq, gxs, ga, gb, smem); break;
+    }
+}
+
+static __global__ void __launch_bounds__(DENSE_GPU_THREADS, 2) k_dense_gpu_persist(dense_gpu_mbox * mbox, dense_gpu_dev * dev,
+        const dense_gpu_wdesc * __restrict__ wtab, int8_t * gxq, uint16_t * gxs, int last, unsigned long long idle_ns) {
+    extern __shared__ __align__(16) char dense_smem[];
+    __shared__ int s_exit;
+    const int tid = threadIdx.x, nblk = gridDim.x;
+    unsigned int bgen = 0;
+    unsigned long long clk_c = 0, clk_n = 0, c0 = 0, n0 = 0;
+    for (int n = 1; ; ++n) {
+        // block 0 waits for a job and publishes it in dev->job
+        if (tid == 0) {
+            if (blockIdx.x == 0) {
+                int s = mbox->seq;
+                bool quit = false;
+                const unsigned long long t0 = dense_gpu_ns();
+                while (s == last) {
+                    if (dense_gpu_ns() - t0 > idle_ns) {
+                        // exit unless a job came in after state = 0 was visible (the host checks state after posting)
+                        mbox->state = 0;
+                        __threadfence_system();
+                        s = mbox->seq;
+                        if (s == last) {
+                            quit = true;
+                            break;
+                        }
+                        mbox->state = 1;
+                        __threadfence_system();
+                        break;
+                    }
+                    s = mbox->seq;
+                }
+                if (quit) {
+                    dev->job.w = -1;
+                } else {
+                    __threadfence_system();
+                    // independent 16-byte loads: one round trip over PCIe
+                    int4 jv[sizeof(dense_gpu_job)/16];
+#pragma unroll
+                    for (int i = 0; i < (int) (sizeof(dense_gpu_job)/16); ++i) {
+                        jv[i] = __ldcv((const int4 *) &mbox->job + i);
+                    }
+#pragma unroll
+                    for (int i = 0; i < (int) (sizeof(dense_gpu_job)/16); ++i) {
+                        ((int4 *) &dev->job)[i] = jv[i];
+                    }
+                    if (dev->job.w < 0) {
+                        mbox->state = 0;
+                        __threadfence_system();
+                    }
+                }
+                mbox->t[0] = dense_gpu_ns();
+                dev->seq = s;
+                __threadfence();
+                dev->cmd = n;
+            } else {
+                while (dev->cmd != n) {
+                }
+                __threadfence();
+            }
+            s_exit = __ldcg(&dev->job.w) < 0;
+        }
+        __syncthreads();
+        if (s_exit) {
+            return;
+        }
+        dense_gpu_job job;
+#pragma unroll
+        for (int i = 0; i < (int) (sizeof(dense_gpu_job)/16); ++i) {
+            ((int4 *) &job)[i] = __ldcg((const int4 *) &dev->job + i);
+        }
+        const int seq = *(volatile int *) &dev->seq;
+        const dense_gpu_wdesc & wd = wtab[job.w];
+        const int K = wd.nb*256, n32 = K/32;
+
+        // activations: Q8_x_X4 rows (host) -> int8 [row][K] and 16-bit scales [row][K/32] (device), 8 bytes per thread
+        const int nrows = job.n_set*job.ncols;
+        const int nitem = nrows*(K/8);
+        const int bsize = job.xbf16 ? 144 : 136, qoff = job.xbf16 ? 16 : 8;
+        for (int i = blockIdx.x*blockDim.x + tid; i < nitem; i += nblk*blockDim.x) {
+            const int r = i/(K/8), q = (i % (K/8))/16, part = i % 16;
+            const char * src = job.xq + r*job.row_size + q*bsize;
+            *(int2 *) (gxq + (long long) r*K + q*128 + part*8) = __ldcv((const int2 *) (src + qoff + part*8));
+            if (part == 0) {
+                *(int2 *) (gxs + (long long) r*n32 + q*4) = __ldcv((const int2 *) src);
+            }
+        }
+        dense_gpu_grid_sync(dev, bgen, nblk);
+        if (tid == 0 && blockIdx.x == 0) {
+            mbox->t[1] = dense_gpu_ns();
+            c0 = clock64();
+            n0 = dense_gpu_ns();
+        }
+
+        const int ga = (int) ((long long) wd.ngroups*blockIdx.x/nblk), gb = (int) ((long long) wd.ngroups*(blockIdx.x + 1)/nblk);
+        if (gb > ga) {
+            if (job.xbf16) {
+                dense_gpu_part_x<true>(wd, job, gxq, gxs, ga, gb, dense_smem);
+            } else {
+                dense_gpu_part_x<false>(wd, job, gxq, gxs, ga, gb, dense_smem);
+            }
+        }
+        if (job.w2 >= 0) {
+            // h = silu(gate)*up, one warp per (column, 32 values), into gxq/gxs (no block reads them any more)
+            const dense_gpu_wdesc & wd2 = wtab[job.w2];
+            const int nff = wd2.nb*256, m32 = nff/32, lane = tid % 32;
+            dense_gpu_grid_sync(dev, bgen, nblk);
+            for (int i = blockIdx.x*(blockDim.x/32) + tid/32; i < job.ncols*m32; i += nblk*(blockDim.x/32)) {
+                const int c = i/m32, j = i % m32;
+                const float * hc = job.y + (long long) c*job.ldy + j*32 + lane;
+                float u = __ldcg(hc), g = __ldcg(hc + nff);
+                g = g/(1.0f + __expf(-g));
+                if (job.limit > 1e-6f) {
+                    g = fminf(g, job.limit);
+                    u = fmaxf(-job.limit, fminf(job.limit, u));
+                }
+                const float v = u*g;
+                float amax = fabsf(v);
+#pragma unroll
+                for (int o = 16; o > 0; o >>= 1) {
+                    amax = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, o));
+                }
+                gxq[(long long) c*nff + j*32 + lane] = (int8_t) __float2int_rn(amax > 0.0f ? v*(127.0f/amax) : 0.0f);
+                if (lane == 0) {
+                    gxs[(long long) c*m32 + j] = __half_as_ushort(__float2half(amax/127.0f));
+                }
+            }
+            dense_gpu_grid_sync(dev, bgen, nblk);
+            dense_gpu_job j2 = job;
+            j2.y = job.y2;
+            j2.ldy = job.ldy2;
+            j2.s2y = 0;
+            j2.n_set = 1;
+            const int ga2 = (int) ((long long) wd2.ngroups*blockIdx.x/nblk), gb2 = (int) ((long long) wd2.ngroups*(blockIdx.x + 1)/nblk);
+            if (gb2 > ga2) {
+                dense_gpu_part_x<false>(wd2, j2, gxq, gxs, ga2, gb2, dense_smem);
+            }
+        }
+        __syncthreads();
+        if (tid == 0 && blockIdx.x == 0) {
+            clk_c += clock64() - c0;
+            clk_n += dense_gpu_ns() - n0;
+            mbox->clk[0] = clk_c;
+            mbox->clk[1] = clk_n;
+        }
+        if (tid == 0) {
+            __threadfence_system();
+            if (atomicAdd(&dev->fin, 1) == (unsigned int) n*nblk - 1) {
+                mbox->t[2] = dense_gpu_ns();
+                __threadfence_system();
+                mbox->done = seq;
+                __threadfence_system();
+            }
+        }
+        last = seq;
+    }
+}
+
+// consecutive Q6_K rows -> 4-row groups
+static __global__ void k_dense_gpu_repack(const block_q6_K * __restrict__ src, int nb, long long ngroups, char * __restrict__ dst) {
+    const long long i = (long long) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= ngroups*nb*4) {
+        return;
+    }
+    const int g = i % 4;
+    const long long gb = i/4, G = gb/nb;
+    const int b = gb % nb;
+    // blocks are 210 bytes: only 2-byte aligned
+    const block_q6_K * B = src + (4*G + g)*nb + b;
+    char * d = dst + gb*DENSE_GPU_G4;
+    for (int t = 0; t < 128; t += 2) {
+        *(uint16_t *) (d + g*128 + t) = *(const uint16_t *) (B->ql + t);
+    }
+    for (int t = 0; t < 64; t += 2) {
+        *(uint16_t *) (d + 512 + g*64 + t) = *(const uint16_t *) (B->qh + t);
+    }
+    for (int t = 0; t < 16; t += 2) {
+        *(uint16_t *) (d + 768 + g*16 + t) = *(const uint16_t *) (B->scales + t);
+    }
+    *(float *) (d + 832 + g*4) = __half2float(*(const half *) &B->d);
+}
+
+struct dense_gpu_weight {
+    bool on = false;
+    int  n_nodes = 0;
+    int  idx = -1;
+    int64_t gpu_rows[8] = {};
+};
+
+struct dense_gpu_state {
+    bool   on = false;
+    float  frac = 0.6f;
+    int    debug = 0;
+    size_t budget = 0, used = 0;
+    dense_gpu_wdesc * d_wtab = nullptr;
+    int    n_w = 0, max_w = 4096;
+    dense_gpu_mbox * mbox = nullptr;  // pinned
+    dense_gpu_mbox * mbox_dev = nullptr;
+    dense_gpu_dev  * d_dev = nullptr;
+    int8_t * d_xq = nullptr;
+    uint16_t * d_xs = nullptr;
+    char   * qbuf = nullptr;          // pinned: the CPU quantises src1 here
+    char   * qbuf_dev = nullptr;
+    size_t   qbuf_size = 2 << 20;
+    cudaStream_t stream = nullptr;
+    cudaEvent_t  ev_exit = nullptr;
+    bool running = false;
+    int  seq = 0;
+    int  nblk = 0;
+    unsigned long long idle_ns = 100000000ull;
+    std::unordered_map<const void *, dense_gpu_weight> w;
+    // chain jobs (GGML_DENSE_GPU_SHEXP): pinned input, device buffer for the up/gate results, weights by up's data
+    bool   chain = true;
+    char * cqbuf = nullptr, * cqbuf_dev = nullptr;
+    size_t cqbuf_size = 1 << 20;
+    float * d_h = nullptr;
+    int64_t d_h_size = 8*2*16384;
+    int    chain_seq = 0;
+    std::unordered_map<const void *, std::array<int, 2>> chain_w; // wtab index of up+gate and of down, -1: not on the GPU
+    int64_t n_calls = 0, t_wait = 0, n_start = 0; // GGML_DENSE_GPU_DEBUG=2
+    // GGML_DENSE_GPU_DEBUG=3, per weight name: calls, ns from post to done, GPU ns copying and computing, bytes
+    const char * cur = nullptr;
+    int64_t cur_bytes = 0, t_post = 0;
+    std::map<std::string, std::array<double, 5>> prof;
+    bool budget_set = false;
+    std::vector<void *> dev_w; // the weights' device memory (GGML_VRAM_SWITCH frees it)
+};
+
+static int64_t dense_gpu_now_ns() {
+    timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t) ts.tv_sec*1000000000 + ts.tv_nsec;
+}
+
+// the VRAM budget for weights: GGML_DENSE_GPU_MB, or the free memory less GGML_DENSE_GPU_RESERVE_MB, measured when the
+// state is made or, with GGML_DENSE_GPU_AFTER_PROMPT, at the first decode after the prompt path has been set up
+static void dense_gpu_size_budget(dense_gpu_state & st) {
+    if (st.budget_set) {
+        return;
+    }
+    st.budget_set = true;
+    size_t free_mem = 0, total_mem = 0;
+    CUDA_CHECK(cudaMemGetInfo(&free_mem, &total_mem));
+    const char * r = getenv("GGML_DENSE_GPU_RESERVE_MB"), * mb = getenv("GGML_DENSE_GPU_MB");
+    const size_t reserve = (size_t) (r ? atof(r) : 768.0) << 20;
+    st.budget = mb ? (size_t) atof(mb) << 20 : free_mem > reserve ? free_mem - reserve : 0;
+    if (st.debug) {
+        fprintf(stderr, "dense_gpu: frac %.2f, %.0f MB for weights (free %.0f MB), %d blocks\n", st.frac,
+                st.budget/1048576.0, free_mem/1048576.0, st.nblk);
+    }
+}
+
+static dense_gpu_state * dense_gpu_create() {
+    auto * st = new dense_gpu_state();
+    const char * on = getenv("GGML_DENSE_GPU");
+    if (!on || atoi(on) == 0) {
+        return st;
+    }
+    auto envf = [](const char * name, float def) { const char * e = getenv(name); return e ? (float) atof(e) : def; };
+    st->frac    = envf("GGML_DENSE_GPU_FRAC", st->frac);
+    st->debug   = (int) envf("GGML_DENSE_GPU_DEBUG", 0.0f);
+    st->idle_ns = (unsigned long long) (envf("GGML_DENSE_GPU_IDLE_MS", 100.0f)*1e6);
+    st->chain   = envf("GGML_DENSE_GPU_SHEXP", 1.0f) != 0.0f;
+    ggml_cuda_set_device(0);
+    int per_sm = 0;
+    CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per_sm, k_dense_gpu_persist, DENSE_GPU_THREADS, DENSE_GPU_SMEM));
+    st->nblk = per_sm*ggml_cuda_info().devices[0].nsm;
+    if (st->nblk < 1) {
+        fprintf(stderr, "%s: k_dense_gpu_persist does not fit, GGML_DENSE_GPU off\n", __func__);
+        return st;
+    }
+    CUDA_CHECK(cudaStreamCreateWithFlags(&st->stream, cudaStreamNonBlocking));
+    CUDA_CHECK(cudaEventCreateWithFlags(&st->ev_exit, cudaEventDisableTiming));
+    CUDA_CHECK(cudaHostAlloc((void **) &st->mbox, sizeof(dense_gpu_mbox), cudaHostAllocMapped));
+    CUDA_CHECK(cudaHostGetDevicePointer((void **) &st->mbox_dev, st->mbox, 0));
+    memset((void *) st->mbox, 0, sizeof(dense_gpu_mbox));
+    CUDA_CHECK(cudaHostAlloc((void **) &st->qbuf, st->qbuf_size, cudaHostAllocMapped));
+    CUDA_CHECK(cudaHostGetDevicePointer((void **) &st->qbuf_dev, st->qbuf, 0));
+    CUDA_CHECK(cudaMalloc((void **) &st->d_dev, sizeof(dense_gpu_dev)));
+    CUDA_CHECK(cudaMalloc((void **) &st->d_xq, st->qbuf_size));
+    CUDA_CHECK(cudaMalloc((void **) &st->d_xs, st->qbuf_size/16));
+    CUDA_CHECK(cudaMalloc((void **) &st->d_wtab, st->max_w*sizeof(dense_gpu_wdesc)));
+    CUDA_CHECK(cudaHostAlloc((void **) &st->cqbuf, st->cqbuf_size, cudaHostAllocMapped));
+    CUDA_CHECK(cudaHostGetDevicePointer((void **) &st->cqbuf_dev, st->cqbuf, 0));
+    CUDA_CHECK(cudaMalloc((void **) &st->d_h, st->d_h_size*sizeof(float)));
+    st->on = true;
+    if (!dense_gpu_waits_for_prompt()) {
+        dense_gpu_size_budget(*st);
+    }
+    return st;
+}
+
+static dense_gpu_state & dense_gpu_get() {
+    static dense_gpu_state * st = dense_gpu_create();
+    return *st;
+}
+
+static inline void dense_gpu_pause() {
+    __asm__ __volatile__("pause");
+}
+
+static void dense_gpu_stop(dense_gpu_state & st) {
+    if (!st.running) {
+        return;
+    }
+    st.mbox->job.w = -1;
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    st.mbox->seq = ++st.seq;
+    CUDA_CHECK(cudaStreamSynchronize(st.stream));
+    st.mbox->done = st.seq; // the exit job counts as done
+    st.running = false;
+}
+
+static void dense_gpu_start(dense_gpu_state & st) {
+    ggml_cuda_set_device(0);
+    CUDA_CHECK(cudaMemsetAsync(st.d_dev, 0, sizeof(dense_gpu_dev), st.stream));
+    st.mbox->state = 1;
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    k_dense_gpu_persist<<<st.nblk, DENSE_GPU_THREADS, DENSE_GPU_SMEM, st.stream>>>(st.mbox_dev, st.d_dev, st.d_wtab, st.d_xq, st.d_xs,
+            st.mbox->done, st.idle_ns);
+    CUDA_CHECK(cudaGetLastError());
+    CUDA_CHECK(cudaEventRecord(st.ev_exit, st.stream));
+    st.running = true;
+    st.n_start++;
+}
+
+// the kernel sets state = 0 when it exits after idle_ns
+static bool dense_gpu_exited(dense_gpu_state & st) {
+    if (st.running && st.mbox->state == 0 && cudaEventQuery(st.ev_exit) == cudaSuccess) {
+        st.running = false;
+    }
+    return !st.running;
+}
+
+// the last frac of the rows of each node's share, uploaded and repacked
+static bool dense_gpu_register(dense_gpu_state & st, dense_gpu_weight & e, const ggml_tensor * src0, int n_nodes) {
+    const int64_t Nx = src0->ne[1], R = Nx*src0->ne[2];
+    const int nb = (int) (src0->ne[0]/256);
+    if (R % (4*n_nodes) != 0 || Nx % 4 != 0 || st.n_w == st.max_w || src0->nb[1] != (size_t) nb*sizeof(block_q6_K)) {
+        return false;
+    }
+    // GGML_DENSE_GPU_FRACS="name:frac,...": the GPU share of the weights whose name contains name
+    float frac = st.frac;
+    if (const char * fl = getenv("GGML_DENSE_GPU_FRACS")) {
+        std::string l = fl;
+        for (size_t a = 0; a < l.size(); ) {
+            size_t b = l.find(',', a);
+            if (b == std::string::npos) b = l.size();
+            const std::string item = l.substr(a, b - a);
+            const size_t c = item.rfind(':');
+            if (c != std::string::npos && strstr(src0->name, item.substr(0, c).c_str())) {
+                frac = (float) atof(item.c_str() + c + 1);
+                break;
+            }
+            a = b + 1;
+        }
+    }
+    if (frac <= 0.0f) {
+        return false;
+    }
+    int64_t total = 0;
+    for (int k = 0; k < n_nodes; ++k) {
+        e.gpu_rows[k] = (int64_t) (frac*(R/n_nodes)/4)*4;
+        total += e.gpu_rows[k];
+    }
+    const size_t bytes = (size_t) total/4*nb*DENSE_GPU_G4;
+    if (total == 0 || st.used + bytes > st.budget) {
+        return false;
+    }
+    dense_gpu_wdesc wd = {};
+    wd.nb = nb;
+    int g = 0;
+    for (int k = 0; k < n_nodes; ++k) {
+        const int64_t end = R*(k + 1)/n_nodes;
+        for (int64_t r = end - e.gpu_rows[k]; r < end; ) {
+            const int64_t i02 = r/Nx, ix = r - i02*Nx, n = std::min(end - r, Nx - ix);
+            if (wd.n_seg == DENSE_GPU_MAX_SEG) {
+                return false;
+            }
+            wd.seg[wd.n_seg++] = {g, (int) (n/4), (int) i02, (int) ix};
+            g += (int) (n/4);
+            r += n;
+        }
+    }
+    wd.ngroups = g;
+    const int64_t t_up0 = ggml_time_us();
+    dense_gpu_stop(st);
+    ggml_cuda_set_device(0);
+    char * d_w = nullptr;
+    if (cudaMalloc((void **) &d_w, bytes) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    wd.w = d_w;
+    st.dev_w.push_back(d_w);
+    const int64_t row_bytes = src0->nb[1];
+    const int64_t chunk = std::min<int64_t>(total, std::max<int64_t>(4, ((64 << 20)/row_bytes)/4*4));
+    void * stage = nullptr;
+    if (cudaMalloc(&stage, chunk*row_bytes) != cudaSuccess) {
+        (void) cudaGetLastError();
+        CUDA_CHECK(cudaFree(d_w));
+        st.dev_w.pop_back();
+        st.budget = st.used;
+        if (st.debug) {
+            fprintf(stderr, "dense_gpu: no room to upload %s, %.0f MB in all\n", src0->name, st.used/1048576.0);
+        }
+        return false;
+    }
+    for (int s = 0; s < wd.n_seg; ++s) {
+        const dense_gpu_seg & sg = wd.seg[s];
+        const int64_t r0 = (int64_t) sg.i02*Nx + sg.ix0;
+        for (int64_t i = 0; i < 4*sg.ngroups; i += chunk) {
+            const int64_t n = std::min<int64_t>(chunk, 4*sg.ngroups - i);
+            CUDA_CHECK(cudaMemcpyAsync(stage, (const char *) src0->data + (r0 + i)*row_bytes, n*row_bytes, cudaMemcpyHostToDevice, st.stream));
+            k_dense_gpu_repack<<<(n*nb + 255)/256, 256, 0, st.stream>>>((const block_q6_K *) stage, nb, n/4,
+                    d_w + (int64_t) (sg.g0 + i/4)*nb*DENSE_GPU_G4);
+        }
+    }
+    CUDA_CHECK(cudaMemcpyAsync(st.d_wtab + st.n_w, &wd, sizeof(wd), cudaMemcpyHostToDevice, st.stream));
+    CUDA_CHECK(cudaStreamSynchronize(st.stream));
+    CUDA_CHECK(cudaFree(stage));
+    e.idx = st.n_w++;
+    st.used += bytes;
+    g_vram_switch_us += ggml_time_us() - t_up0;
+    if (st.debug) {
+        fprintf(stderr, "dense_gpu: %s %lld x %lld, %lld rows on the GPU in %d segments, %.1f MB (%.0f MB in all)\n", src0->name,
+                (long long) src0->ne[0], (long long) R, (long long) total, wd.n_seg, bytes/1048576.0, st.used/1048576.0);
+    }
+    return true;
+}
+
+// whole matrices, one after the other as the rows of one weight (part i from row ix0 = the rows before it);
+// the wtab index or -1
+static int dense_gpu_register_whole(dense_gpu_state & st, const ggml_tensor * const * t, int n) {
+    const int nb = (int) (t[0]->ne[0]/256);
+    dense_gpu_wdesc wd = {};
+    wd.nb = nb;
+    int64_t rows = 0;
+    for (int i = 0; i < n; ++i) {
+        if (t[i]->type != GGML_TYPE_Q6_K || t[i]->ne[0] != t[0]->ne[0] || t[i]->ne[1] % 4 != 0 || t[i]->ne[2] != 1 ||
+            t[i]->nb[1] != (size_t) nb*sizeof(block_q6_K) || wd.n_seg == DENSE_GPU_MAX_SEG) {
+            return -1;
+        }
+        wd.seg[wd.n_seg++] = {(int) (rows/4), (int) (t[i]->ne[1]/4), 0, (int) rows};
+        rows += t[i]->ne[1];
+    }
+    wd.ngroups = (int) (rows/4);
+    const size_t bytes = (size_t) rows/4*nb*DENSE_GPU_G4;
+    if (st.n_w == st.max_w || st.used + bytes > st.budget) {
+        return -1;
+    }
+    const int64_t t_up0 = ggml_time_us();
+    dense_gpu_stop(st);
+    ggml_cuda_set_device(0);
+    char * d_w = nullptr;
+    if (cudaMalloc((void **) &d_w, bytes) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return -1;
+    }
+    wd.w = d_w;
+    st.dev_w.push_back(d_w);
+    const int64_t row_bytes = t[0]->nb[1];
+    const int64_t chunk = std::max<int64_t>(4, ((64 << 20)/row_bytes)/4*4);
+    void * stage = nullptr;
+    if (cudaMalloc(&stage, chunk*row_bytes) != cudaSuccess) {
+        (void) cudaGetLastError();
+        CUDA_CHECK(cudaFree(d_w));
+        st.dev_w.pop_back();
+        st.budget = st.used;
+        if (st.debug) {
+            fprintf(stderr, "dense_gpu: no room to upload %s, %.0f MB in all\n", t[0]->name, st.used/1048576.0);
+        }
+        return -1;
+    }
+    for (int s = 0; s < wd.n_seg; ++s) {
+        for (int64_t i = 0; i < 4*wd.seg[s].ngroups; i += chunk) {
+            const int64_t m = std::min<int64_t>(chunk, 4*wd.seg[s].ngroups - i);
+            CUDA_CHECK(cudaMemcpyAsync(stage, (const char *) t[s]->data + i*row_bytes, m*row_bytes, cudaMemcpyHostToDevice, st.stream));
+            k_dense_gpu_repack<<<(m*nb + 255)/256, 256, 0, st.stream>>>((const block_q6_K *) stage, nb, m/4,
+                    d_w + (int64_t) (wd.seg[s].g0 + i/4)*nb*DENSE_GPU_G4);
+        }
+    }
+    CUDA_CHECK(cudaMemcpyAsync(st.d_wtab + st.n_w, &wd, sizeof(wd), cudaMemcpyHostToDevice, st.stream));
+    CUDA_CHECK(cudaStreamSynchronize(st.stream));
+    CUDA_CHECK(cudaFree(stage));
+    st.used += bytes;
+    g_vram_switch_us += ggml_time_us() - t_up0;
+    if (st.debug) {
+        fprintf(stderr, "dense_gpu: %s%s %lld x %lld whole, %.1f MB (%.0f MB in all)\n", t[0]->name, n > 1 ? " (+ more)" : "",
+                (long long) t[0]->ne[0], (long long) rows, bytes/1048576.0, st.used/1048576.0);
+    }
+    return st.n_w++;
+}
+
+static bool vram_switch_on() {
+    static const bool on = [] { const char * e = getenv("GGML_VRAM_SWITCH"); return e && atoi(e) != 0; }();
+    return on;
+}
+static int g_vram_mode = 0;                               // 1: prompt, 2: decoding
+static std::vector<ggml_backend_cuda_context *> g_vram_ctx; // the backend contexts that computed prompt splits
+
+// a graph of more than 8 tokens: the dense split takes up to 8
+static bool vram_graph_is_prompt(const ggml_cgraph * g) {
+    for (int i = 0; i < g->n_nodes; ++i) {
+        const ggml_tensor * t = g->nodes[i];
+        if ((t->op == GGML_OP_MUL_MAT && t->src[1]->ne[1] > 8) || (t->op == GGML_OP_MUL_MAT_ID && t->src[1]->ne[2] > 8) ||
+            (t->op == GGML_OP_FLASH_ATTN_EXT && t->src[0]->ne[1] > 8)) {
+            return true;
+        }
+    }
+    return false;
+}
