+// The sparse form (no mask, src[5] = visible rows per query) as ggml_cuda_flash_attn_ext turns it into
+// a mask for ggml_cuda_fa_gemm: is it a prompt batch that path takes?
+static bool ggml_cuda_fa_gemm_index_ok(const ggml_tensor * dst) {
+    static const int enabled = [] { const char * e = getenv("GGML_FA_GEMM"); return e ? atoi(e) : 1; }();
+    const ggml_tensor * Q   = dst->src[0];
+    const ggml_tensor * K   = dst->src[1];
+    const ggml_tensor * V   = dst->src[2];
+    const ggml_tensor * idx = dst->src[5];
+    float max_bias = 0.0f, logit_softcap = 0.0f;
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    const int64_t D = Q->ne[0], nq = Q->ne[1];
+    return enabled && D == 512 && K->ne[0] == D && V->ne[0] == D && V->ne[1] == K->ne[1] && nq >= 32 &&
+        max_bias == 0.0f && logit_softcap == 0.0f && idx->type == GGML_TYPE_I32 && idx->ne[1] >= nq &&
+        idx->ne[2] == 1 && idx->ne[3] == 1 && K->type == GGML_TYPE_F16 && V->type == GGML_TYPE_F16 &&
+        Q->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 && Q->ne[3] == 1 && K->ne[2] == 1 && K->ne[3] == 1 &&
+        V->ne[2] == 1 && V->ne[3] == 1 && K->nb[0] == sizeof(half) && V->nb[0] == sizeof(half) &&
+        Q->nb[0] == sizeof(float) && Q->nb[2] == D*sizeof(float) && Q->nb[1] == Q->ne[2]*D*sizeof(float) &&
+        ggml_is_contiguous(dst) && (!dst->src[4] || (dst->src[4]->type == GGML_TYPE_F32 && dst->src[4]->ne[0] >= Q->ne[2]));
+}
