+// MOE_FUSED_UP_GATE with SILU: min(silu(gate), limit) * clamp(up, -limit, limit) (no clamp for limit 0)
+static __global__ void k_moe_gpu_silu(const float * __restrict__ g, const float * __restrict__ u, float * __restrict__ p, int64_t n, float limit) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    const float x = g[i];
+    float s = x/(1.0f + expf(-x));
+    float y = u[i];
+    if (limit > 1e-6f) {
+        s = fminf(s, limit);
+        y = fmaxf(-limit, fminf(limit, y));
+    }
+    p[i] = s*y;
+}
+
+static __global__ void k_moe_gpu_scatter(const float4 * __restrict__ src, const int32_t * __restrict__ rows, float4 * __restrict__ dst, int n4) {
+    const float4 * s = src + (int64_t) blockIdx.x*n4;
+    float4 * d = dst + (int64_t) rows[blockIdx.x]*n4;
+    for (int i = threadIdx.x; i < n4; i += blockDim.x) {
+        d[i] = s[i];
+    }
