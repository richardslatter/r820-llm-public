+                        __m128 vmx = _mm_set1_ps(-INFINITY);
+                        for (; j0 + 4 <= nb; j0 += 4) {
+                            const __m128 sv = _mm_add_ps(_mm_mul_ps(_mm_loadu_ps(p + j0), vsc), _mm_loadu_ps(mv + j0));
+                            _mm_storeu_ps(p + j0, sv); vmx = _mm_max_ps(vmx, sv);
+                        }
+                        vmx = _mm_max_ps(vmx, _mm_movehl_ps(vmx, vmx));
+                        vmx = _mm_max_ss(vmx, _mm_shuffle_ps(vmx, vmx, 1));
+                        mx = _mm_cvtss_f32(vmx);
+                    }
+                    for (int j = j0; j < nb; ++j) {
+                        const float s = softcap == 0.0f ? p[j]*scale + mv[j] : softcap*tanhf(p[j]*scale) + mv[j];
+                        p[j] = s; mx = MAX(mx, s);
+                    }
+                    const float M = MAX(st[Dv], mx);
+                    if (M == -INFINITY) {
+                        // nothing visible yet: leave the state as it is
+                        for (int j = 0; j < nb; ++j) p[j] = 0.0f;
+                        corr[h - h0] = 1.0f;
+                        continue;
+                    }
+                    const float cf = st[Dv] == -INFINITY ? 0.0f : expf(st[Dv] - M);
+                    float S = st[Dv + 1]*cf;
+                    int j = 0;
+                    {
+                        const __m128 vM = _mm_set1_ps(M), lo = _mm_set1_ps(-104.0f);
+                        __m128 vS = _mm_setzero_ps();
+                        for (; j + 4 <= nb; j += 4) {
+                            const __m128 e = ggml_v_expf(_mm_max_ps(_mm_sub_ps(_mm_loadu_ps(p + j), vM), lo));
+                            _mm_storeu_ps(p + j, e); vS = _mm_add_ps(vS, e);
+                        }
+                        vS = _mm_add_ps(vS, _mm_movehl_ps(vS, vS));
+                        S += _mm_cvtss_f32(_mm_add_ss(vS, _mm_shuffle_ps(vS, vS, 1)));
+                    }
+                    for (; j < nb; ++j) { p[j] = expf(p[j] - M); S += p[j]; }
+                    corr[h - h0] = cf; st[Dv] = M; st[Dv + 1] = S;
+                }
+
+                FAP(FAP_SM);
+                // accumulators: o_h = o_h*corr_h + sum_j p_h[j]*V[j]
+                for (h = h0; h + 4 <= h1; h += 4) {
+                    ggml_fa_pv_4(st0 + h*SD, SD, P + (h - h0)*BR, corr + (h - h0), Vr, Dv, nb);
+                }
+                for (; h < h1; ++h) {
+                    ggml_fa_pv_1(st0 + h*SD, P + (h - h0)*BR, corr[h - h0], Vr, Dv, nb);
+                }
+                FAP(FAP_PV);
+            }
+        }
+        for (int64_t a = 0; a < nqp; ++a) {
+            for (int64_t h = h0; h < h1; ++h) {
+                const float * src = acc + (a*hpt + h - h0)*SD;
+                float * dstp = part + (((iq + a)*C + c)*H + h)*SD;
+                for (int64_t d = 0; d < Dv + 8; d += 8) _mm256_stream_ps(dstp + d, _mm256_load_ps(src + d));
+            }
+        }
+        _mm_sfence();
+    }
+
+    FAP(FAP_SETUP);
+    ggml_barrier(params->shared);
+    FAP(FAP_BAR);
+
+    // merge the chunk states of each (query, head), fold in the sink, normalise: a node its own heads
+    const int64_t HN = H/NN, np = NQ*HN;
+    for (int64_t pi = np*li/TPN; pi < np*(li + 1)/TPN; ++pi) {
+        const int64_t iq1 = pi / HN, h = node*HN + pi % HN;
+        for (int cc = 0; cc < C; ++cc) {
+            const char * st = (const char *)(part + ((iq1*C + cc)*H + h)*SD);
+            for (int64_t o = 0; o < (Dv + 16)*(int64_t) sizeof(float); o += 64) _mm_prefetch(st + o, _MM_HINT_T0);
+        }
+        float M = -INFINITY;
+        for (int cc = 0; cc < C; ++cc) M = MAX(M, part[((iq1*C + cc)*H + h)*SD + Dv]);
+        float * out = (float *)((char *) dst->data + (iq1*dst->ne[1] + h)*dst->nb[1]);
+        float S = 0.0f;
+        memset(out, 0, Dv*sizeof(float));
+        if (M != -INFINITY) {
+            for (int cc = 0; cc < C; ++cc) {
+                const float * st = part + ((iq1*C + cc)*H + h)*SD;
+                if (st[Dv] == -INFINITY) continue;
+                const float w = expf(st[Dv] - M);
+                S += w*st[Dv + 1];
+                const __m256 wv = _mm256_set1_ps(w);
+                for (int64_t d = 0; d < Dv; d += 8) {
+                    _mm256_storeu_ps(out + d, _mm256_add_ps(_mm256_loadu_ps(out + d), _mm256_mul_ps(wv, _mm256_loadu_ps(st + d))));
+                }
+            }
+        }
+        if (sinks) {
+            const float sk = ((const float *) sinks->data)[h];
+            if (sk > M) {
+                const float ms = expf(M - sk);
+                for (int64_t d = 0; d < Dv; ++d) out[d] *= ms;
+                S = S*ms + 1.0f;
+            } else {
+                S += expf(sk - M);
+            }
+        }
+        const float S_inv = S == 0.0f ? 0.0f : 1.0f/S;
+        for (int64_t d = 0; d < Dv; ++d) out[d] *= S_inv;
+    }
+    FAP(FAP_MERGE);
+    return true;
+}
