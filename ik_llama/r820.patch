+        return;
+    }
+    const char * y[ny];
+    for (int iy = 0; iy < ny; ++iy) y[iy] = info.src1_row(iy);
+    avx1_gemv::gemm_mxfp4<2, 2>(n, vx, bx, y, ny, nrc_x, [&info](int ix, int iy, float v) { info.store(ix, iy, v); });
