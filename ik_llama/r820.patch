diff --git a/ggml/src/ggml-cuda/mmq_fq.cuh b/ggml/src/ggml-cuda/mmq_fq.cuh
new file mode 100644
index 00000000..7bff86b5
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmq_fq.cuh
@@ -0,0 +1,384 @@
+// dp4a matrix multiplication for MXFP4 and Q6_K weights on Pascal (sm_61), for prompt batches.
+//
+// The stock MMQ kernels reach ~4 int8 TOPS on the P2200 (~30% of the dp4a rate): each dp4a needs a shared load,
+// and every 32 values go through an int-to-float conversion at quarter rate. Here a thread keeps R rows x T tokens
+// of accumulators and loads 8 ints of a row once for T tokens; the y loads are warp broadcasts. The integer sums
+// are turned into floats without I2F: seeded with 0x4B400000 they are the float 12582912 + sum (|sum| < 2^22),
+// and the offset is taken out in the FMA that applies the weight scale (exact for MXFP4, whose scales are powers of
+// two: the results match the stock kernel's bit for bit). ~1.3x the stock kernels on these shapes.
+//
+// x: weights decoded per k chunk of 128 values into shared memory as int8, with one float scale per 32 (MXFP4) or
+// per 16 (Q6_K: d*scale) values. y: src1 as quantize_mmq_q8_1 writes it for these types (D4 layout, one float
+// scale per 32 values), [k/128][stride11] blocks. GGML_FQ=0 turns it off; GGML_FQ=2 also runs the stock kernel
+// and prints the largest difference per call; GGML_FQ_MIN: fewest src1 columns to take this path (48).
+#pragma once
+
+#include "common.cuh"
+
+#define FQ_MAGIC_I 0x4B400000
+#define FQ_MAGIC_F 12582912.0f
+
+static __device__ __forceinline__ int2 fq_lut_mxfp4(const int q4) {
+    // 16 nibbles to int8 through the e2m1 table (doubled), as byte permutes
+    const uint32_t v0 = 0x03020100, v1 = 0x0C080604, v2 = 0xFDFEFF00, v3 = 0xF4F8FAFC;
+    const uint32_t mask = 0x32103210 | ((q4 & 0x88888888) >> 1);
+    const uint32_t a = __byte_perm(__byte_perm(v0, v1, q4),       __byte_perm(v2, v3, q4),       mask);
+    const uint32_t b = __byte_perm(__byte_perm(v0, v1, q4 >> 16), __byte_perm(v2, v3, q4 >> 16), mask >> 16);
+    return make_int2(__byte_perm(a, b, 0x6420), __byte_perm(a, b, 0x7531));
+}
+
+static __device__ __forceinline__ int fq_ld_b2(const char * p) { // 4 bytes from a 2-byte aligned address
+    const uint16_t * q = (const uint16_t *) p;
+    return (int) (q[0] | ((uint32_t) q[1] << 16));
+}
+
+// per type: a row's 128 values of a k chunk go to shared memory as 32 ints of int8 and NSC float scales, in 4 units
+// per row; load() reads a unit's NI ints from global memory into registers, store() writes them to shared memory
+template <ggml_type type> struct fq_fmt;
+
+template <> struct fq_fmt<GGML_TYPE_MXFP4> {
+    static constexpr int NSC = 4;
+    static constexpr int NI  = 5;
+    // unit u: mxfp4 block u of the chunk; the chunk's 4 blocks are 68 contiguous bytes
+    static __device__ __forceinline__ void load(int (&r)[NI], const char * row, const int c, const int u) {
+        const int * p = (const int *) row + 17*c + 4*u;
+#pragma unroll
+        for (int i = 0; i < NI; ++i) r[i] = p[i];
+    }
+    static __device__ __forceinline__ void store(const int (&r)[NI], int * xrow, float * srow, const int u) {
+        const int sel = 0x3210 + (u + 1)*0x1111;
+        const uint32_t e = (r[0] >> (8*u)) & 0xff;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int2 v = fq_lut_mxfp4(__byte_perm(r[i], r[i + 1], sel));
+            xrow[8*u + i]     = v.x;
+            xrow[8*u + i + 4] = v.y;
+        }
+        // the table is doubled: 2^(e - 127) / 2
+        srow[u] = 0.5f*__uint_as_float(e ? e << 23 : 0x00400000);
+    }
+};
+
+template <> struct fq_fmt<GGML_TYPE_Q6_K> {
+    static constexpr int NSC = 8;
+    static constexpr int NI  = 7;
+    // unit u: l in [8u, 8u+8) of the chunk (half of a block): ql[l], ql[l + 32], qh[l]; scales 2u, 2u+1; d
+    static __device__ __forceinline__ void load(int (&r)[NI], const char * row, const int c, const int u) {
+        const char * b = row + (c >> 1)*sizeof(block_q6_K);
+        const int h = c & 1;
+        r[0] = fq_ld_b2(b + 64*h + 8*u);
+        r[1] = fq_ld_b2(b + 64*h + 8*u + 4);
+        r[2] = fq_ld_b2(b + 64*h + 32 + 8*u);
+        r[3] = fq_ld_b2(b + 64*h + 32 + 8*u + 4);
+        r[4] = fq_ld_b2(b + 128 + 32*h + 8*u);
+        r[5] = fq_ld_b2(b + 128 + 32*h + 8*u + 4);
+        r[6] = fq_ld_b2(b + 192 + 8*h + 2*u) & 0xffff;
+        r[6] |= (int) (*(const uint16_t *) (b + 208)) << 16;
+    }
+    static __device__ __forceinline__ int fix(const int g) { // 6-bit q to int8 q - 32, per byte
+        const int x = g ^ 0x20202020;
+        const int s = x & 0x20202020;
+        return x | (s << 1) | (s << 2);
+    }
+    static __device__ __forceinline__ void store(const int (&r)[NI], int * xrow, float * srow, const int u) {
+#pragma unroll
+        for (int i = 0; i < 2; ++i) {
+            const int a = r[i], b = r[2 + i], q = r[4 + i];
+            xrow[ 0 + 2*u + i] = fix(( a       & 0x0F0F0F0F) | ((q << 4) & 0x30303030));
+            xrow[ 8 + 2*u + i] = fix(( b       & 0x0F0F0F0F) | ((q << 2) & 0x30303030));
+            xrow[16 + 2*u + i] = fix(((a >> 4) & 0x0F0F0F0F) | ( q       & 0x30303030));
+            xrow[24 + 2*u + i] = fix(((b >> 4) & 0x0F0F0F0F) | ((q >> 2) & 0x30303030));
+        }
+        const float d = __half2float(__ushort_as_half((unsigned short) (r[6] >> 16)));
+        srow[2*u]     = d*(float) (int8_t) (r[6] & 0xff);
+        srow[2*u + 1] = d*(float) (int8_t) ((r[6] >> 8) & 0xff);
+    }
+};
+
+// weights already in the D4 layout (rows of K/128 blocks of 36 ints: 4 float scales, 128 int8 in order), as fq_quant
+// writes them. The kernel takes the offset out with -scale*12582912, exact only for scales of at most 22 significant
+// bits, so fq_quant rounds the scales up to that.
+template <> struct fq_fmt<GGML_TYPE_Q8_1> {
+    static constexpr int NSC = 4;
+    static constexpr int NI  = 9;
+    // unit u: the 32 values of scale u
+    static __device__ __forceinline__ void load(int (&r)[NI], const char * row, const int c, const int u) {
+        const int * p = (const int *) row + 36*c;
+        const int4 a = *(const int4 *) (p + 4 + 8*u);
+        const int4 b = *(const int4 *) (p + 8 + 8*u);
+        r[0] = a.x; r[1] = a.y; r[2] = a.z; r[3] = a.w;
+        r[4] = b.x; r[5] = b.y; r[6] = b.z; r[7] = b.w;
+        r[8] = p[u];
+    }
+    static __device__ __forceinline__ void store(const int (&r)[NI], int * xrow, float * srow, const int u) {
+#pragma unroll
+        for (int i = 0; i < 8; ++i) xrow[8*u + i] = r[i];
+        srow[u] = __int_as_float(r[8]);
+    }
+};
+
+static __device__ __forceinline__ float fq_scale(const float amax) { // amax/127 rounded up to 22 significant bits
+    return __uint_as_float((__float_as_uint(amax/127.0f) + 3) & ~3u);
+}
+
+static __device__ __forceinline__ int fq_pack(const float * v, const float id) {
+    int q = 0;
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        const int x = max(-127, min(127, __float2int_rn(v[j]*id)));
+        q |= (x & 0xff) << (8*j);
+    }
+    return q;
+}
+
+// n rows of K values (row r at src + (idx ? idx[r] : r)*s_row) times mul, zero padded to Kp, to the D4 layout:
+// block (r, c) at dst + r*dn + c*dc ints. One warp per block, blockDim (32, 8).
+template <typename T>
+static __global__ void k_fq_quant(const T * __restrict__ src, const int * __restrict__ idx, const int64_t s_row, const int n,
+        const int K, const int Kp, const float mul, int * __restrict__ dst, const int64_t dn, const int64_t dc) {
+    const int lane = threadIdx.x, nc = Kp/128;
+    const int64_t p = (int64_t) blockIdx.x*blockDim.y + threadIdx.y;
+    if (p >= (int64_t) n*nc) {
+        return;
+    }
+    const int r = (int) (p / nc), c = (int) (p % nc);
+    const T * x = src + (idx ? idx[r] : r)*s_row;
+    float v[4], amax = 0.0f;
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        const int k = 128*c + 4*lane + j;
+        v[j] = k < K ? (float) x[k]*mul : 0.0f;
+        amax = fmaxf(amax, fabsf(v[j]));
+    }
+#pragma unroll
+    for (int o = 1; o < 8; o <<= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, o));
+    const float d = fq_scale(amax);
+    int * b = dst + r*dn + c*dc;
+    b[4 + lane] = fq_pack(v, d > 0.0f ? 1.0f/d : 0.0f);
+    if (lane % 8 == 0) {
+        ((float *) b)[lane/8] = d;
+    }
+}
+
+// the transpose: columns d0..d0+31 of rows idx[0..L) of src (f16), zero padded to Kp rows, as rows d of a [D][Kp]
+// matrix in the D4 layout, block (d, c) at dst + d*dn + c*36. grid (Kp/128, D/32), 128 threads.
+static __global__ void k_fq_quant_t(const half * __restrict__ src, const int * __restrict__ idx, const int64_t s_row, const int L,
+        int * __restrict__ dst, const int64_t dn) {
+    __shared__ float tile[128][33];
+    const int c = blockIdx.x, d0 = 32*blockIdx.y, t = threadIdx.x;
+#pragma unroll 4
+    for (int i = 0; i < 32; ++i) {
+        const int l = 4*i + t/32, lg = 128*c + l;
+        tile[l][t % 32] = lg < L ? __half2float(src[idx[lg]*s_row + d0 + t % 32]) : 0.0f;
+    }
+    __syncthreads();
+    const int d = t % 32, u = t / 32;
+    float amax = 0.0f;
+#pragma unroll
+    for (int j = 0; j < 32; ++j) amax = fmaxf(amax, fabsf(tile[32*u + j][d]));
+    const float s = fq_scale(amax), id = s > 0.0f ? 1.0f/s : 0.0f;
+    int * b = dst + (d0 + d)*dn + 36*c;
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        const float v[4] = { tile[32*u + 4*i][d], tile[32*u + 4*i + 1][d], tile[32*u + 4*i + 2][d], tile[32*u + 4*i + 3][d] };
+        b[4 + 8*u + i] = fq_pack(v, id);
+    }
+    ((float *) b)[u] = s;
+}
+
+// block tile BM rows x BN tokens, k chunks of 128 values; the next chunk's global loads go to registers before the
+// current chunk's dot products. LS = false: lane = row within a group of 32, warp = group of T tokens. LS = true:
+// lanes are 8 row groups x 4 token groups and WM warps share the rows, so a shared load touches fewer addresses.
+template <ggml_type type, int R, int T, int MINB, int NW, bool LS, int WM>
+static __global__ void __launch_bounds__(32*NW, MINB) mul_mat_fq(const char * __restrict__ W, const int * __restrict__ Y,
+        float * __restrict__ D, const int M, const int K, const int N, const int w_stride, const int y_stride, const int d_stride) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 610
+    using F = fq_fmt<type>;
+    constexpr int NSC = F::NSC, NI = F::NI;
+    constexpr int SX = NSC == 4 ? 36 : 44;   // ints per row in xs: 32 values, NSC scales, padding
+    constexpr int SY = 36;                   // one block_q8_1_mmq per token
+    constexpr int BM = LS ? WM*8*R : 32*R, BN = LS ? NW/WM*4*T : NW*T, NT = 32*NW;
+    constexpr int XP = (BM*4 + NT - 1)/NT;   // (row, unit) pairs per thread
+    constexpr int YP = (BN*9 + NT - 1)/NT;   // int4 of y per thread
+    constexpr int RS = LS ? 8 : 32, TS = LS ? 4 : 1;
+    __shared__ int xs[BM*SX];
+    __shared__ int ys[BN*SY];
+    const int lane = threadIdx.x, warp = threadIdx.y, tid = warp*32 + lane;
+    const int row0 = blockIdx.x*BM, tok0 = blockIdx.y*BN;
+    const int nchunk = K/128;
+    const int rl0 = LS ? (warp % WM)*8*R + (lane & 7) : lane;     // first local row, step RS
+    const int tl0 = LS ? (warp / WM)*4*T + (lane >> 3) : warp*T;  // first local token, step TS
+
+    float acc[R][T];
+#pragma unroll
+    for (int r = 0; r < R; ++r)
+#pragma unroll
+        for (int t = 0; t < T; ++t) acc[r][t] = 0.0f;
+
+    int  xr[XP][NI];
+    int4 yr[YP];
+    const char * xsrc[XP];
+#pragma unroll
+    for (int p = 0; p < XP; ++p) {
+        const int pr = min(tid + NT*p, BM*4 - 1);
+        const int row = min(row0 + (pr >> 2), M - 1);
+        xsrc[p] = W + (int64_t) row*w_stride;
+    }
+    auto gload = [&](const int c) {
+#pragma unroll
+        for (int p = 0; p < XP; ++p) F::load(xr[p], xsrc[p], c, (tid + NT*p) & 3);
+        const int4 * ysrc = (const int4 *) (Y + ((int64_t) c*y_stride + tok0)*36);
+#pragma unroll
+        for (int q = 0; q < YP; ++q) {
+            const int i = tid + NT*q;
+            yr[q] = i < BN*9 && tok0 + i/9 < N ? ysrc[i] : make_int4(0, 0, 0, 0);
+        }
+    };
+    gload(0);
+    for (int c = 0; c < nchunk; ++c) {
+        __syncthreads();
+#pragma unroll
+        for (int p = 0; p < XP; ++p) {
+            const int pr = tid + NT*p;
+            if (BM*4 % NT != 0 && pr >= BM*4) break;
+            const int rr = pr >> 2;
+            F::store(xr[p], xs + rr*SX, (float *) (xs + rr*SX + 32), pr & 3);
+        }
+#pragma unroll
+        for (int q = 0; q < YP; ++q) {
+            const int i = tid + NT*q;
+            if (i < BN*9) *(int4 *) (ys + i*4) = yr[q];
+        }
+        __syncthreads();
+        if (c + 1 < nchunk) gload(c + 1);
+
+#pragma unroll 1
+        for (int b = 0; b < 4; ++b) {
+            int4 xv[R][2];
+            float sx[R][2], cx[R];
+#pragma unroll
+            for (int r = 0; r < R; ++r) {
+                const int * xrow = xs + (rl0 + RS*r)*SX;
+                xv[r][0] = *(const int4 *) (xrow + 8*b);
+                xv[r][1] = *(const int4 *) (xrow + 8*b + 4);
+                if (NSC == 4) {
+                    sx[r][0] = __int_as_float(xrow[32 + b]);
+                    sx[r][1] = 0.0f;
+                    cx[r] = -sx[r][0]*FQ_MAGIC_F;
+                } else {
+                    const float2 s = *(const float2 *) (xrow + 32 + 2*b);
+                    sx[r][0] = s.x;
+                    sx[r][1] = s.y;
+                    cx[r] = -s.x*FQ_MAGIC_F;
+                }
+            }
+#pragma unroll
+            for (int t = 0; t < T; ++t) {
+                const int * yrow = ys + (tl0 + TS*t)*SY;
+                const int4 y0 = *(const int4 *) (yrow + 4 + 8*b);
+                const int4 y1 = *(const int4 *) (yrow + 4 + 8*b + 4);
+                const float dy = __int_as_float(yrow[b]);
+#pragma unroll
+                for (int r = 0; r < R; ++r) {
+                    int s0 = FQ_MAGIC_I;
+                    s0 = ggml_cuda_dp4a(xv[r][0].x, y0.x, s0);
+                    s0 = ggml_cuda_dp4a(xv[r][0].y, y0.y, s0);
+                    s0 = ggml_cuda_dp4a(xv[r][0].z, y0.z, s0);
+                    s0 = ggml_cuda_dp4a(xv[r][0].w, y0.w, s0);
+                    float p;
+                    if (NSC == 4) {
+                        s0 = ggml_cuda_dp4a(xv[r][1].x, y1.x, s0);
+                        s0 = ggml_cuda_dp4a(xv[r][1].y, y1.y, s0);
+                        s0 = ggml_cuda_dp4a(xv[r][1].z, y1.z, s0);
+                        s0 = ggml_cuda_dp4a(xv[r][1].w, y1.w, s0);
+                        p = fmaf(sx[r][0], __int_as_float(s0), cx[r]);
+                    } else {
+                        int s1 = FQ_MAGIC_I;
+                        s1 = ggml_cuda_dp4a(xv[r][1].x, y1.x, s1);
+                        s1 = ggml_cuda_dp4a(xv[r][1].y, y1.y, s1);
+                        s1 = ggml_cuda_dp4a(xv[r][1].z, y1.z, s1);
+                        s1 = ggml_cuda_dp4a(xv[r][1].w, y1.w, s1);
+                        // the second sum is taken out of its offset on its own (exact): folding both offsets
+                        // into one constant would round an intermediate ~1e7 times the result
+                        p = fmaf(sx[r][0], __int_as_float(s0), cx[r]);
+                        p = fmaf(sx[r][1], __int_as_float(s1) - FQ_MAGIC_F, p);
+                    }
+                    acc[r][t] = fmaf(dy, p, acc[r][t]);
+                }
+            }
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < T; ++t) {
+        const int tok = tok0 + tl0 + TS*t;
+        if (tok >= N) continue;
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+            const int row = row0 + rl0 + RS*r;
+            if (row < M) D[(int64_t) tok*d_stride + row] = acc[r][t];
+        }
+    }
+#else
+    GGML_UNUSED(W); GGML_UNUSED(Y); GGML_UNUSED(D); GGML_UNUSED(M); GGML_UNUSED(K); GGML_UNUSED(N);
+    GGML_UNUSED(w_stride); GGML_UNUSED(y_stride); GGML_UNUSED(d_stride);
+    NO_DEVICE_CODE;
+#endif
+}
+
+static __global__ void k_fq_diff(const float * __restrict__ a, const float * __restrict__ b, const int M, const int N, const int stride,
+        float * __restrict__ out) {
+    float d = 0.0f, m = 0.0f;
+    for (int64_t i = blockIdx.x*(int64_t) blockDim.x + threadIdx.x; i < (int64_t) M*N; i += (int64_t) gridDim.x*blockDim.x) {
+        const int64_t k = (i/M)*stride + i % M;
+        d = fmaxf(d, fabsf(a[k] - b[k]));
+        m = fmaxf(m, fabsf(b[k]));
+    }
+    atomicMax((int *) out + 0, __float_as_int(d));
+    atomicMax((int *) out + 1, __float_as_int(m));
+}
+
+template <ggml_type type, int R, int T, int MINB, int NW, bool LS, int WM>
+static void fq_launch(const char * x, const char * y, float * dst, const int M, const int K, const int N, const int w_stride,
+        const int y_stride, const int d_stride, cudaStream_t stream) {
+    constexpr int BM = LS ? WM*8*R : 32*R, BN = LS ? NW/WM*4*T : NW*T;
+    const dim3 grid((M + BM - 1)/BM, (N + BN - 1)/BN);
+    mul_mat_fq<type, R, T, MINB, NW, LS, WM><<<grid, dim3(32, NW), 0, stream>>>(x, (const int *) y, dst, M, K, N, w_stride, y_stride, d_stride);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// true if it took the multiplication; args: mmq_args (a template parameter, so files without mmq.cuh can include
+// this one); stock() runs the stock kernel (GGML_FQ=2 compares the two)
+template <ggml_type type, typename Args, typename Stock>
+static bool ggml_cuda_fq_mul_mat(ggml_backend_cuda_context & ctx, const Args & args, cudaStream_t stream, const Stock & stock) {
+    static const int mode   = [] { const char * e = getenv("GGML_FQ");     return e ? atoi(e) : 1; }();
+    static const int n_min  = [] { const char * e = getenv("GGML_FQ_MIN"); return e ? atoi(e) : 48; }();
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    if (!mode || cc < 610 || cc >= CC_VOLTA || args.ne11 < n_min || args.ne00 % 128 != 0 ||
+            args.ne01 > INT_MAX || args.stride01 > INT_MAX || args.stride11 > INT_MAX/36) {
+        return false;
+    }
+    const int M = (int) args.ne01, K = (int) args.ne00, N = (int) args.ne11;
+    ggml_cuda_pool_alloc<float> tmp(ctx.pool());
+    float * dst = args.dst;
+    if (mode == 2) {
+        dst = tmp.alloc((int64_t) args.ne0*N);
+    }
+    if (N >= 512) {
+        fq_launch<type, 4, 8, 1, 16, false, 4>(args.x, args.y, dst, M, K, N, (int) args.stride01, (int) args.stride11, (int) args.ne0, stream);
+    } else if (type == GGML_TYPE_MXFP4) {
+        fq_launch<type, 4, 8, 2, 8, true, 4>(args.x, args.y, dst, M, K, N, (int) args.stride01, (int) args.stride11, (int) args.ne0, stream);
+    } else {
+        fq_launch<type, 4, 8, 2, 8, false, 4>(args.x, args.y, dst, M, K, N, (int) args.stride01, (int) args.stride11, (int) args.ne0, stream);
+    }
+    if (mode == 2) {
+        stock();
+        ggml_cuda_pool_alloc<float> res(ctx.pool(), 2);
+        CUDA_CHECK(cudaMemsetAsync(res.ptr, 0, 2*sizeof(float), stream));
+        k_fq_diff<<<64, 256, 0, stream>>>(dst, args.dst, M, N, (int) args.ne0, res.ptr);
+        float h[2];
+        CUDA_CHECK(cudaMemcpyAsync(h, res.ptr, sizeof(h), cudaMemcpyDeviceToHost, stream));
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        fprintf(stderr, "fq %s M %d K %d N %d: max|diff| %.3g max|ref| %.3g\n", ggml_type_name(type), M, K, N, h[0], h[1]);
+    }
+    return true;
+}
