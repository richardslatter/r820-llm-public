+// Prompt batches on Pascal, head size 512: gathered rows + SGEMM (see fa_gemm_patch.py)
+#define FA_GEMM_CHUNK 64
+
+// rows[c][:n_rows[c]]: the K/V rows that at least one query of chunk c can see, in order
+static __global__ void k_fa_gemm_rows(const half * __restrict__ mask, const int n_kv, const int s1, const int nq,
+        int * __restrict__ rows, int * __restrict__ n_rows) {
+    const int c  = blockIdx.x;
+    const int t0 = c*FA_GEMM_CHUNK;
+    const int t1 = min(nq, t0 + FA_GEMM_CHUNK);
+    const int lane = threadIdx.x % WARP_SIZE, warp = threadIdx.x / WARP_SIZE, nwarps = blockDim.x / WARP_SIZE;
+    __shared__ int warp_sums[32];
+    int base = 0;
+    for (int j0 = 0; j0 < n_kv; j0 += blockDim.x) {
+        const int j = j0 + threadIdx.x;
+        int need = 0;
+        if (j < n_kv) {
+            for (int t = t0; t < t1 && !need; ++t) {
+                need = __half2float(mask[(int64_t)t*s1 + j]) != -INFINITY;
+            }
+        }
+        int v = need;
+#pragma unroll
+        for (int o = 1; o < WARP_SIZE; o <<= 1) {
+            const int n = __shfl_up_sync(0xffffffff, v, o);
+            if (lane >= o) v += n;
+        }
+        if (lane == WARP_SIZE - 1) warp_sums[warp] = v;
+        __syncthreads();
+        if (warp == 0) {
+            int w = lane < nwarps ? warp_sums[lane] : 0;
+#pragma unroll
+            for (int o = 1; o < WARP_SIZE; o <<= 1) {
+                const int n = __shfl_up_sync(0xffffffff, w, o);
+                if (lane >= o) w += n;
+            }
+            warp_sums[lane] = w;
+        }
+        __syncthreads();
+        if (need) {
+            rows[(int64_t)c*n_kv + base + v - 1 + (warp > 0 ? warp_sums[warp - 1] : 0)] = j;
+        }
+        base += warp_sums[nwarps - 1];
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        n_rows[c] = base;
+    }
+}
+
+static __global__ void k_fa_gemm_gather(const char * __restrict__ src, const size_t nb1, const int * __restrict__ rows,
+        const int D, float * __restrict__ dst) {
+    const half * x = (const half *) (src + (int64_t) rows[blockIdx.x]*nb1);
+    float * y = dst + (int64_t) blockIdx.x*D;
+    for (int d = threadIdx.x; d < D; d += blockDim.x) {
+        y[d] = __half2float(x[d]);
+    }
+}
+
+static __device__ __forceinline__ float fa_gemm_block_reduce(float x, const bool is_max, float * buf) {
+    x = is_max ? warp_reduce_max(x) : warp_reduce_sum(x);
+    const int lane = threadIdx.x % WARP_SIZE, warp = threadIdx.x / WARP_SIZE, nwarps = blockDim.x / WARP_SIZE;
+    if (lane == 0) buf[warp] = x;
+    __syncthreads();
+    x = lane < nwarps ? buf[lane] : (is_max ? -INFINITY : 0.0f);
+    x = is_max ? warp_reduce_max(x) : warp_reduce_sum(x);
+    __syncthreads();
+    return x;
+}
+
+// one block per row r = token*n_head + head of S [R][L] (KQ, already scaled): mask, sinks, softmax, in place
+static __global__ void k_fa_gemm_softmax(float * __restrict__ S, const int L, const half * __restrict__ mask, const int s1,
+        const int * __restrict__ rows, const int t0, const int n_head, const float * __restrict__ sinks) {
+    __shared__ float buf[32];
+    const int r = blockIdx.x;
+    const int t = t0 + r / n_head;
+    const int h = r % n_head;
+    float * x = S + (int64_t) r*L;
+    const half * m = mask + (int64_t) t*s1;
+    float mx = -INFINITY;
+    for (int l = threadIdx.x; l < L; l += blockDim.x) {
+        const float v = x[l] + __half2float(m[rows[l]]);
+        x[l] = v;
+        mx = fmaxf(mx, v);
+    }
+    mx = fa_gemm_block_reduce(mx, true, buf);
+    const float sink = sinks ? sinks[h] : -INFINITY;
+    mx = fmaxf(mx, sink);
+    if (mx == -INFINITY) {
+        mx = 0.0f;
+    }
+    float sum = 0.0f;
+    for (int l = threadIdx.x; l < L; l += blockDim.x) {
+        const float e = expf(x[l] - mx);
+        x[l] = e;
+        sum += e;
+    }
+    sum = fa_gemm_block_reduce(sum, false, buf) + (sinks ? expf(sink - mx) : 0.0f);
+    const float inv = sum > 0.0f ? 1.0f/sum : 0.0f;
+    for (int l = threadIdx.x; l < L; l += blockDim.x) {
+        x[l] *= inv;
+    }
+}
+
+static __global__ void k_fa_gemm_diff(const float * __restrict__ a, const float * __restrict__ b, const int64_t n, float * __restrict__ out) {
+    float d = 0.0f, m = 0.0f;
+    for (int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x; i < n; i += (int64_t) gridDim.x*blockDim.x) {
+        d = fmaxf(d, fabsf(a[i] - b[i]));
+        m = fmaxf(m, fabsf(b[i]));
+    }
+    d = warp_reduce_max(d);
+    m = warp_reduce_max(m);
+    if (threadIdx.x % WARP_SIZE == 0) {
+        atomicMax((int *) out + 0, __float_as_int(d));
+        atomicMax((int *) out + 1, __float_as_int(m));
+    }
+}
