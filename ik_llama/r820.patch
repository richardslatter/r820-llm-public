+static __global__ void k_moe_gpu_gather(const float * __restrict__ src, const int32_t * __restrict__ rows, float * __restrict__ dst, int ne0) {
+    const int r = blockIdx.x;
+    const float * s = src + (int64_t) rows[r]*ne0;
+    float * d = dst + (int64_t) r*ne0;
+    for (int i = threadIdx.x; i < ne0; i += blockDim.x) {
+        d[i] = s[i];
+    }
