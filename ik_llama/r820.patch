+// moe_out_add_patch.py: the experts' weighted sum (MUL_MULTI_ADD) and the shared expert's ADD after it as one node for
+// a few tokens, each thread on its column slice of both: one barrier instead of two, bit-identical.
+// GGML_MOE_OUT_FUSE=0 turns it off.
+static int ggml_moe_out_add_on(void) {
+    static int on = -1, ab = -1;
+    if (on < 0) {
