+// fp16_sse41_patch.py: ggml_compute_fp32_to_fp16 on four floats, the same float and integer steps (bit-identical)
+static inline __m128i ggml_fp32_to_fp16_sse41(__m128 f) {
+    const __m128i w      = _mm_castps_si128(f);
+    const __m128  absf   = _mm_castsi128_ps(_mm_and_si128(w, _mm_set1_epi32(0x7FFFFFFF)));
+    __m128 base = _mm_mul_ps(_mm_mul_ps(absf, _mm_set1_ps(0x1.0p+112f)), _mm_set1_ps(0x1.0p-110f));
+    const __m128i shl1_w = _mm_add_epi32(w, w);
+    const __m128i sign   = _mm_and_si128(w, _mm_set1_epi32((int) 0x80000000u));
+    __m128i bias = _mm_and_si128(shl1_w, _mm_set1_epi32((int) 0xFF000000u));
+    bias = _mm_max_epu32(bias, _mm_set1_epi32(0x71000000));
+    base = _mm_add_ps(_mm_castsi128_ps(_mm_add_epi32(_mm_srli_epi32(bias, 1), _mm_set1_epi32(0x07800000))), base);
+    const __m128i bits     = _mm_castps_si128(base);
+    const __m128i exp_bits = _mm_and_si128(_mm_srli_epi32(bits, 13), _mm_set1_epi32(0x00007C00));
+    const __m128i man_bits = _mm_and_si128(bits, _mm_set1_epi32(0x00000FFF));
+    const __m128i nonsign  = _mm_add_epi32(exp_bits, man_bits);
+    // shl1_w > 0xFF000000 as unsigned: NaN
+    const __m128i is_nan = _mm_cmpgt_epi32(_mm_xor_si128(shl1_w, _mm_set1_epi32((int) 0x80000000u)), _mm_set1_epi32(0x7F000000));
+    return _mm_or_si128(_mm_srli_epi32(sign, 16), _mm_blendv_epi8(nonsign, _mm_set1_epi32(0x7E00), is_nan));
+}
