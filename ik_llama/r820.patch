+static int ggml_moe_out_add_fused(const struct ggml_compute_params * params, const struct ggml_cgraph * cgraph, int i) {
+    if (i + 1 >= cgraph->n_nodes || !ggml_moe_out_add_on()) {
+        return i;
+    }
+    struct ggml_tensor * ma = cgraph->nodes[i];
+    struct ggml_tensor * ad = cgraph->nodes[i + 1];
+    const int ith = params->ith, nth = params->nth;
+    if (ad->op != GGML_OP_ADD || (ad->src[0] == ma) == (ad->src[1] == ma)) {
+        return i;
+    }
+    const bool ma_first = ad->src[0] == ma;
+    const struct ggml_tensor * sh = ma_first ? ad->src[1] : ad->src[0];
+    const int64_t ne0 = ma->ne[0], nr = ma->ne[1];
+    if (!sh || ma->type != GGML_TYPE_F32 || sh->type != GGML_TYPE_F32 || ad->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(ma) || !ggml_is_contiguous(sh) || !ggml_is_contiguous(ad) ||
+        !ggml_are_same_shape(ma, sh) || !ggml_are_same_shape(ma, ad) || ma->ne[2] != 1 || ma->ne[3] != 1 ||
+        !ma->src[0] || ma->src[0]->ne[0] != ne0 || nr >= nth || ne0 < 16*nth) {
+        return i;
+    }
+    // the ADD's output: in place on one of its inputs, or apart from everything the two nodes read
+    if ((ad->data != ma->data && ggml_moe_out_overlap(ad, ma)) || (ad->data != sh->data && ggml_moe_out_overlap(ad, sh))) {
+        return i;
+    }
+    for (int j = 0; j < 4; ++j) {
+        if (ma->src[j] && ggml_moe_out_overlap(ad, ma->src[j])) {
+            return i;
+        }
+    }
+
+    iqk_mul_multi_add(ma, ith, nth);
+
+    // MUL_MULTI_ADD's column slice for fewer rows than threads
+    const int64_t k0 = (ne0/16)*ith/nth*16;
+    const int64_t k1 = ith == nth - 1 ? ne0 : (ne0/16)*(ith + 1)/nth*16;
+    for (int64_t r = 0; r < nr; ++r) {
+        const float * x = (const float *)((const char *) ma->data + r*ma->nb[1]);
+        const float * y = (const float *)((const char *) sh->data + r*sh->nb[1]);
+              float * z = (float *)((char *) ad->data + r*ad->nb[1]);
+        if (ma_first) {
+            for (int64_t k = k0; k < k1; ++k) z[k] = x[k] + y[k];
+        } else {
+            for (int64_t k = k0; k < k1; ++k) z[k] = y[k] + x[k];
+        }
+    }
+    return i + 1;
+}
